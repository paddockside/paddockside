@inherits LayoutComponentBase
@implements IDisposable
@inject SessionState Session
@inject NavigationManager Navigation

<div class="grid min-h-screen grid-cols-[minmax(0,1fr)] grid-rows-[auto_1fr]">
    <AppHeader TenantName="@Session.Current?.TenantName">
        <Actions>
            @if (Session.Current is not null)
            {
                <nav aria-label="Main" class="flex items-center gap-4">
                    <a href="horses" class="btn-link">Horses</a>
                    <a href="inbound" class="btn-link">Inbound mail</a>
                    @if (Session.Current.Role == "TenantAdmin")
                    {
                        <a href="members" class="btn-link">Members</a>
                    }
                </nav>
                <button type="button" class="btn-secondary" @onclick="SignOut">Sign out</button>
            }
        </Actions>
    </AppHeader>

    <main class="mx-auto w-full max-w-5xl px-4 py-6 sm:px-6 sm:py-8">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task SignOut()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("sign-in");
    }

    public void Dispose() => Session.Changed -= Refresh;
}
