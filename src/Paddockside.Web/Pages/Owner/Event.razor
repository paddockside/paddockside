@page "/my/events/{Id:guid}"
@layout OwnerLayout
@inherits OwnerPage
@inject IJSRuntime JS

@*
    One event as an owner sees it (search-reporting.md §3; the owner mockup): the horse and the event as a sentence,
    the steps owners care about, then everything newest first on one spine: only what is scoped to them, only their
    own replies, no internal notes, no delivery figures, and no other owner ever named. Beside it (above it on a
    phone), the event at a glance, their share, their earlier events and "Contact {tenant}", the help control
    (design-system.md §2.0). The reply bar at the bottom writes to staff about this horse. Every notification link
    lands here, on its item ("#item-…"), scrolled into view and highlighted.
*@
<PageTitle>@(_page?.Heading ?? _page?.Event.Title ?? "Update")</PageTitle>

<div class="grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
    @if (_error is not null)
    {
        <a href="my/horses" class="btn-link justify-self-start">← My horses</a>
        <Error Message="@_error" />
    }
    else if (_page is null)
    {
        <p class="text-text-muted" role="status">Loading…</p>
    }
    else
    {
        <header class="grid gap-5 lg:col-start-1">
            <div class="flex items-center gap-4 sm:gap-6">
                <span aria-hidden="true" class="grid size-[56px] shrink-0 place-items-center rounded-card bg-scope-owners-bg text-title font-heading text-scope-owners-fg sm:size-[88px] sm:text-heading">@Monograms.Of(_page.Horse)</span>
                <div class="grid min-w-0 gap-1">
                    <nav class="text-small text-text-muted" aria-label="Breadcrumb">
                        <a href="my/horses" class="underline underline-offset-4">My horses</a> ›
                        <a href="my/horses/@_page.HorseId" class="underline underline-offset-4">@_page.Horse</a>
                    </nav>
                    <h1 class="text-title font-heading leading-tight sm:text-heading">@(_page.Heading ?? $"{_page.Horse}: {_page.Event.Title}")</h1>
                    <p class="text-text-muted">@Detail</p>
                </div>
            </div>

            @if (_page.Event.Steps.Count > 0)
            {
                <ol class="flex max-w-[760px] flex-wrap items-center gap-3" aria-label="Progress">
                    @for (var i = 0; i < _page.Event.Steps.Count; i++)
                    {
                        var step = _page.Event.Steps[i];
                        if (i > 0)
                        {
                            <li aria-hidden="true" class="hidden h-[3px] min-w-[16px] flex-1 sm:block @(step.State is "Done" or "Current" ? "bg-action-primary-bg" : "bg-border-subtle")"></li>
                        }
                        <li class="flex items-center gap-2 font-strong @(step.State switch { "Done" => "text-text-primary", "Current" => "text-action-primary-bg", _ => "text-text-muted" })"
                            aria-current="@(step.State == "Current" ? "step" : null)">
                            <span aria-hidden="true" class="size-[16px] shrink-0 rounded-pill @(step.State switch { "Done" => "bg-action-primary-bg", "Current" => "border-[5px] border-action-primary-bg bg-surface-raised", _ => "border-2 border-border-strong bg-surface-raised" })"></span>
                            @step.Label<span class="sr-only">, @(step.State switch { "Done" => "done", "Current" => "now", _ => "to come" })</span>
                        </li>
                    }
                </ol>
            }
        </header>

        <aside class="grid grid-cols-[minmax(0,1fr)] gap-6 rounded-card border border-border-subtle bg-surface-raised px-6 py-6 lg:sticky lg:top-6 lg:col-start-2 lg:row-span-3 lg:row-start-1"
               aria-label="About this event">
            <section class="grid gap-3">
                <h2 class="@SideHeading">@(_page.GlanceTitle ?? "At a glance")</h2>
                <dl class="grid grid-cols-[90px_minmax(0,1fr)] gap-x-3 gap-y-2">
                    <dt class="text-text-muted">When</dt>
                    <dd class="font-strong">@_page.Event.KeyDate</dd>
                    @foreach (var f in _page.Glance ?? [])
                    {
                        <dt class="text-text-muted">@f.Label</dt>
                        <dd>@f.Value</dd>
                    }
                    @if (_page.RaceDay is { } raceDay)
                    {
                        @if (raceDay.Gate is not null)
                        {
                            <dt class="text-text-muted">Gate</dt>
                            <dd>@raceDay.Gate</dd>
                        }
                        @if (raceDay.Dining is not null)
                        {
                            <dt class="text-text-muted">Dining</dt>
                            <dd>@raceDay.Dining</dd>
                        }
                        @if (raceDay.Note is not null)
                        {
                            <dt class="text-text-muted">Also</dt>
                            <dd>@raceDay.Note</dd>
                        }
                    }
                    @if (_page.Tickets is { } tickets)
                    {
                        <dt class="text-text-muted">Tickets</dt>
                        <dd class="grid gap-1">
                            <span class="font-strong @(tickets.Confirmed ? "text-action-primary-bg" : null)">@tickets.Line</span>
                            @if (tickets.Note is not null)
                            {
                                <span class="text-small text-text-muted">@tickets.Note</span>
                            }
                        </dd>
                    }
                </dl>
            </section>

            @if (_page.Share is { } share)
            {
                <section class="grid gap-1">
                    <h2 class="@SideHeading">Your share</h2>
                    <p>@share.Line</p>
                    <p class="text-small text-text-muted">@share.Detail</p>
                </section>
            }

            <section class="grid gap-2">
                <h2 class="@SideHeading">Earlier</h2>
                <ul class="grid gap-2">
                    @foreach (var e in _page.Earlier ?? [])
                    {
                        <li><a href="my/events/@e.Id" class="text-action-primary-bg underline underline-offset-4">@e.Title</a></li>
                    }
                    <li><a href="my/horses/@_page.HorseId" class="text-text-muted underline underline-offset-4">All of @(_page.Horse)'s story</a></li>
                </ul>
            </section>

            <div class="grid gap-2">
                <button type="button" class="btn-secondary w-full whitespace-normal" @onclick="FocusContact">Contact @TenantName</button>
                <p class="text-center text-small text-text-muted">Only @TenantName sees what you write.</p>
            </div>
        </aside>

        <section class="lg:col-start-1" aria-label="Updates, newest first">
            @if (_page.Items.Count == 0)
            {
                <div class="card"><p>Nothing posted yet. You'll get an email when there is.</p></div>
            }
            <ol>
                @foreach (var item in _page.Items)
                {
                    var target = item.Id == _target;
                    var (day, time) = When(item.At);
                    <li id="item-@item.Id" tabindex="-1" aria-label="@(item.Title ?? item.Kind)"
                        class="grid grid-cols-[20px_minmax(0,1fr)] gap-x-3 sm:grid-cols-[120px_32px_minmax(0,1fr)] sm:gap-x-4">
                        <p class="hidden pt-[22px] text-right leading-snug text-text-muted sm:block">
                            @day@if (time is not null)
                            {
                                <br /><span class="text-small">@time</span>
                            }
                        </p>
                        <div class="relative flex justify-center" aria-hidden="true">
                            <span class="absolute inset-y-0 w-[3px] bg-border-subtle"></span>
                            <span class="relative mt-[22px] size-[20px] rounded-pill border-4 @(item.Kind == "Result" ? "border-kind-fact-fg bg-kind-fact-fg" : "border-action-primary-bg bg-surface-raised")"></span>
                        </div>
                        <div class="grid min-w-0 gap-2 pb-6 pt-3">
                            <p class="text-small text-text-muted sm:hidden">@item.At</p>
                            <div class="rounded-card @(target ? "ring-4 ring-focus ring-offset-4 ring-offset-surface-default" : null)">
                                <OwnerItemCard Item="item" TenantName="@TenantName" ViewerName="@Session.Current?.Name" Busy="@(_answering == item.Id)"
                                               AnswerError="@_answerError.GetValueOrDefault(item.Id)" OnAnswer="answer => AnswerAsync(item, answer)">
                                    @if (item.CanReply)
                                    {
                                        @* Answer buttons are the reply to a question; words are extra, so they wait behind a link. *@
                                        <details class="grid gap-3 border-t border-border-subtle pt-3" open="@_replyError.ContainsKey(item.Id)">
                                            <summary class="cursor-pointer font-strong text-action-primary-bg underline underline-offset-4">
                                                @(item.Prompt is null ? $"Reply to {TenantName}" : $"Add a message for {TenantName} (optional)")
                                            </summary>
                                            @ReplyForm(item, item.Prompt is null ? "Your reply" : "Your message", "btn-primary")
                                        </details>
                                    }
                                </OwnerItemCard>
                            </div>
                        </div>
                    </li>
                }
            </ol>
        </section>

        <section id="contact" class="sticky bottom-[calc(64px+env(safe-area-inset-bottom))] z-10 grid gap-2 rounded-t-card border border-b-0 border-border-subtle bg-surface-raised p-4 sm:px-[22px] lg:bottom-0 lg:col-start-1"
                 aria-label="Contact @TenantName">
            @if (_contactSent)
            {
                <p class="rounded-control bg-status-success-bg px-4 py-3 text-status-success-fg" role="status">
                    Sent. @TenantName will see it with @(_page.Horse)'s updates and get back to you.
                </p>
            }
            <form class="flex flex-wrap items-end gap-3" @onsubmit="ContactAsync" @onsubmit:preventDefault>
                <label for="contact-body" class="sr-only">Your message to @TenantName about @_page.Horse</label>
                <textarea id="contact-body" rows="1" class="input min-h-[56px] min-w-0 flex-1 basis-[14rem] rounded-card py-3"
                          @bind="_contactDraft" placeholder="@($"Write to {TenantName} about {_page.Horse}…")"></textarea>
                <button type="submit" class="btn-primary min-h-[56px]" disabled="@_contacting">Send</button>
            </form>
            @if (_contactError is not null)
            {
                <p class="font-strong text-status-danger-fg" role="alert">@_contactError</p>
            }
        </section>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private OwnerEventPage? _page;
    private string? _error;
    private Guid? _target;
    private Guid? _sending;
    private bool _scrolled;
    private readonly Dictionary<Guid, string?> _drafts = [];
    private readonly Dictionary<Guid, string> _replyError = [];
    private string? _contactDraft;
    private string? _contactError;
    private bool _contacting;
    private bool _contactSent;

    private const string SideHeading = "text-small font-strong uppercase tracking-wide text-text-muted";

    private string TenantName => Session.Current?.TenantName ?? "us";

    /// <summary>The race and its facts on one line: "Randwick, Race 6 · Barrier 9 · Jockey T. Berry".</summary>
    private string Detail => string.Join(" · ", new[] { _page!.Event.Title }
        .Concat((_page.Glance ?? []).Take(3).Select(f => f.Value.Length > 0 && char.IsDigit(f.Value[0]) ? $"{f.Label} {f.Value}" : f.Value)));

    /// <summary>"Thursday 10 October, 9:12 am" as two lines for the "when" column.</summary>
    private static (string Day, string? Time) When(string at)
    {
        var comma = at.LastIndexOf(", ", StringComparison.Ordinal);
        return comma < 0 ? (at, null) : (at[..comma], at[(comma + 2)..]);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!await EnsureSignedInAsync()) return;
        var hash = new Uri(Navigation.Uri).Fragment;
        _target = hash.StartsWith("#item-", StringComparison.Ordinal) && Guid.TryParse(hash["#item-".Length..], out var id) ? id : null;
        await LoadAsync();

        // Shown once as "New", then it isn't: mark what they have just been shown as seen.
        if (_page is { Event.Unread: > 0 }) await Api.MarkEventSeenAsync(Id);
    }

    private async Task LoadAsync()
    {
        var result = await Api.MyEventAsync(Id);
        if (!result.Succeeded) { _error = result.Error; return; }
        _page = result.Value;
        foreach (var item in _page!.Items.Where(i => i.CanReply)) _drafts.TryAdd(item.Id, null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_page is not null && _target is { } target && !_scrolled)
            _scrolled = await JS.InvokeAsync<bool>("paddockside.scrollToItem", $"item-{target}");
    }

    private async Task FocusContact() => await JS.InvokeAsync<bool>("paddockside.scrollToItem", "contact-body");

    private RenderFragment ReplyForm(OwnerItem item, string label, string buttonClass) => __builder =>
    {
        <form class="mt-3 grid gap-3" @onsubmit="() => ReplyAsync(item)" @onsubmit:preventDefault>
            <label for="reply-@item.Id" class="font-strong">@label</label>
            <textarea id="reply-@item.Id" rows="3" class="rounded-control border border-border-strong bg-surface-raised p-4"
                      @bind="_drafts[item.Id]" placeholder="Only @TenantName will see this."></textarea>
            <button type="submit" class="@buttonClass justify-self-start" disabled="@(_sending == item.Id)">Send</button>
            @if (_replyError.TryGetValue(item.Id, out var problem))
            {
                <p class="font-strong text-status-danger-fg" role="alert">@problem</p>
            }
        </form>
    };

    private Guid? _answering;
    private readonly Dictionary<Guid, string> _answerError = [];

    /// <summary>A tap on an answer: recorded, shown as their reply, and the page reloads to show both.</summary>
    private async Task AnswerAsync(OwnerItem item, string answer)
    {
        _answerError.Remove(item.Id);
        _answering = item.Id;
        try
        {
            var result = await Api.AnswerAsync(item.Id, answer);
            if (!result.Succeeded) { _answerError[item.Id] = result.Error!; return; }
            await LoadAsync();
        }
        finally
        {
            _answering = null;
        }
    }

    private async Task ReplyAsync(OwnerItem item)
    {
        _replyError.Remove(item.Id);
        if (string.IsNullOrWhiteSpace(_drafts[item.Id])) { _replyError[item.Id] = "Write your reply first."; return; }

        _sending = item.Id;
        try
        {
            var result = await Api.ReplyAsync(item.Id, _drafts[item.Id]!);
            if (!result.Succeeded) { _replyError[item.Id] = result.Error!; return; }
            item.Replies.Add(result.Value!);
            _drafts[item.Id] = null;
        }
        finally
        {
            _sending = null;
        }
    }

    private async Task ContactAsync()
    {
        (_contactError, _contactSent) = (null, false);
        if (string.IsNullOrWhiteSpace(_contactDraft)) { _contactError = "Write your message first."; return; }

        _contacting = true;
        try
        {
            var result = await Api.ContactAboutEventAsync(Id, _contactDraft);
            if (!result.Succeeded) { _contactError = result.Error; return; }
            (_contactDraft, _contactSent) = (null, true);
            await LoadAsync();
        }
        finally
        {
            _contacting = false;
        }
    }
}
