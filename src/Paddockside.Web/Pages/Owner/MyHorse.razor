@page "/my/horses/{Id:guid}"
@layout OwnerLayout
@inherits OwnerPage

@*
    One horse: where it's at now (its status, as staff last set it), then its events, newest first, each opening its
    updates. Only the steps owners follow are shown.
*@
<PageTitle>@(_name ?? "Horse")</PageTitle>

<div class="grid grid-cols-[minmax(0,1fr)] gap-4">
    <a href="my/horses" class="btn-link justify-self-start">← My horses</a>
    <h1 class="text-heading font-heading">@_name</h1>
    @if (_horse?.Status is { } status)
    {
        <section class="card grid gap-1" aria-labelledby="where-heading">
            <h2 id="where-heading" class="text-small font-strong uppercase tracking-wide text-text-muted">Where @_name is at</h2>
            <p>@status</p>
            <p class="text-small text-text-muted">Updated @_horse.StatusSet</p>
        </section>
    }
    @if (_error is not null)
    {
        <Error Message="@_error" />
    }
    else if (_events is null)
    {
        <p class="text-text-muted" role="status">Loading…</p>
    }
    else if (_events.Count == 0)
    {
        <div class="card"><p>Nothing yet. Updates about @_name will appear here, and come to you by email too.</p></div>
    }
    else
    {
        @foreach (var e in _events)
        {
            <EventCard Side="Side.Owner" Model='e.ToCard($"my/events/{e.Id}")' />
        }
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private string? _name;
    private OwnerHorse? _horse;
    private List<EventSummary>? _events;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        if (!await EnsureSignedInAsync()) return;
        var horses = await Api.MyHorsesAsync();
        _horse = horses.Value?.FirstOrDefault(h => h.Id == Id);
        _name = _horse?.Name;
        var result = await Api.MyHorseEventsAsync(Id);
        if (result.Succeeded) _events = result.Value;
        else _error = result.Error;
    }
}
