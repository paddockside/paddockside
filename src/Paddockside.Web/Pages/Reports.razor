@page "/reports"
@inject PaddocksideApi Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Reports · Paddockside</PageTitle>

@*
    Reports (search-reporting.md §4), starting with the two that answer "did everyone get told". Unreached owners is
    here: owners who haven't opened any of their last few important messages (acceptances, race-day changes and
    arrangements, results, ownership notices), across all their horses, with what became of them. Delivery by event
    lives on each event, as "Who saw what".
*@
<div class="grid grid-cols-[minmax(0,1fr)] gap-6">
    <h1>Reports</h1>

    <section class="card grid gap-4" aria-labelledby="unreached-heading">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 id="unreached-heading" class="text-title">Unreached owners</h2>
            <a class="btn-link" href="api/reports/unreached/export.csv?last=@_last&days=@_days" download>Download as a spreadsheet (CSV)</a>
        </div>
        <p class="text-text-muted">Owners who haven't opened any of their last few important messages: acceptances, race-day news, results and ownership notices. Opened means the email was opened, they read it in the portal, or they replied.</p>

        <form class="flex flex-wrap items-end gap-3" @onsubmit="LoadAsync" @onsubmit:preventDefault>
            <div class="field">
                <label class="field-label" for="unreached-last">Their last</label>
                <select id="unreached-last" class="input w-auto" @bind="_last" @bind:after="LoadAsync">
                    @foreach (var n in new[] { 1, 2, 3, 5, 10 })
                    {
                        <option value="@n">@n important message@(n == 1 ? null : "s")</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field-label" for="unreached-days">Sent in the last</label>
                <select id="unreached-days" class="input w-auto" @bind="_days" @bind:after="LoadAsync">
                    <option value="30">30 days</option>
                    <option value="90">90 days</option>
                    <option value="180">6 months</option>
                    <option value="365">year</option>
                </select>
            </div>
        </form>

        @if (_error is not null)
        {
            <Error Message="@_error" />
        }
        else if (_report is null)
        {
            <p class="text-text-muted" role="status">Loading…</p>
        }
        else if (_report.Checked == 0)
        {
            <p>No owner has been sent an important message in that time.</p>
        }
        else if (_report.Owners.Count == 0)
        {
            <p class="rounded-control bg-status-success-bg px-4 py-3 text-status-success-fg">All @_report.Checked owners have seen at least one of their last @Messages(_report.Last).</p>
        }
        else
        {
            <p><strong>@_report.Owners.Count of @_report.Checked owners</strong> haven't seen any of their last @Messages(_report.Last).</p>
            <ul class="grid">
                @foreach (var o in _report.Owners)
                {
                    <li class="grid gap-1 border-t border-border-subtle py-3">
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <a href="clients/@o.PartyId" class="font-strong underline-offset-4 hover:underline">@o.Name</a>
                            <span class="text-small text-text-muted">@o.Horses</span>
                        </div>
                        <p class="@(o.Why.StartsWith("Bounced") || o.Why.StartsWith("Not sent") ? "text-status-danger-fg" : null)">@o.Why</p>
                        <p class="text-small text-text-muted">
                            @o.Missed unopened, the latest sent @o.LastSent@(Contact(o) is { } c ? $" · {c}" : null)
                        </p>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card grid gap-2" aria-labelledby="delivery-heading">
        <h2 id="delivery-heading" class="text-title">Who saw what, for one event</h2>
        <p class="text-text-muted">Open any event and choose <strong>Who saw what</strong>: every owner, everything they were sent about it, and whether they opened it.</p>
    </section>
</div>

@code {
    private int _last = 3;
    private int _days = 90;
    private UnreachedReport? _report;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (Session.Current is null && await Session.RefreshAsync() is null)
        {
            Navigation.NavigateTo("sign-in");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        var result = await Api.UnreachedAsync(_last, _days);
        if (result.Succeeded) _report = result.Value;
        else _error = result.Error;
    }

    private static string Messages(int n) => n == 1 ? "important message" : $"{n} important messages";

    private static string? Contact(UnreachedOwner o) =>
        string.Join(" · ", new[] { o.Email, o.Mobile }.Where(c => c is not null)) is { Length: > 0 } c ? c : null;
}
