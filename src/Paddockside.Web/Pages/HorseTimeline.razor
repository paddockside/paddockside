@page "/horses/{Id:guid}"
@inject PaddocksideApi Api
@inject SessionState Session
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject StaffRail Rail

<PageTitle>@(_horse?.Name ?? "Horse") · Paddockside</PageTitle>

@* The horse timeline (search-reporting.md §3): the horse, then every event, newest first. *@
<div class="grid grid-cols-[minmax(0,1fr)] gap-6">
    <a href="horses" class="btn-link justify-self-start">← All horses</a>

    @if (_error is not null)
    {
        <Error Message="@_error" />
    }
    else if (_horse is null)
    {
        <p class="text-text-muted" role="status">Loading…</p>
    }
    else
    {
        <h1 class="sr-only">@_horse.Name</h1>
        <HorseCard Model="_horse.ToCard()" />
        <p class="text-text-muted">
            @(_horse.Managed ? $"Managed since {_horse.ManagedSince}" : "No longer managed")
            · @_horse.CurrentOwners current @(_horse.CurrentOwners == 1 ? "owner" : "owners")
        </p>

        @if (_horse.InboxAddress is { } inbox)
        {
            @* The horse's own inbox (messaging-channels.md §3.1): give it to the trainer, and mail sent to it lands here. *@
            <section class="card grid gap-2" aria-labelledby="inbox-heading">
                <h2 id="inbox-heading" class="text-body font-strong">Email address for @_horse.Name</h2>
                <p class="text-small text-text-muted">Give this to the trainer and anyone else who sends news about this horse. Mail sent to it lands on the horse's open event, or here on the horse if there isn't one.</p>
                <div class="flex flex-wrap items-center gap-3">
                    <code class="break-all rounded-control bg-surface-sunken px-3 py-2">@inbox</code>
                    <button type="button" class="btn-secondary" @onclick="() => Copy(inbox)">@(_copied ? "Copied" : "Copy")</button>
                    <span class="sr-only" role="status">@(_copied ? "Email address copied" : null)</span>
                </div>
            </section>
        }

        @if (_owners is { } owners)
        {
            @* Who owns the horse now (ownership-model.md): staff only. Names here never reach another owner. *@
            <section id="owners" class="grid grid-cols-[minmax(0,1fr)] gap-3" aria-labelledby="owners-heading">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h2 id="owners-heading">Owners</h2>
                    <span class="text-small @(owners.Over ? "font-strong text-status-danger-fg" : "text-text-muted")">@owners.Allocated</span>
                </div>
                @if (owners.Warning is { } warning)
                {
                    <p class="@(owners.Over ? "alert-danger" : "rounded-control bg-status-warning-bg px-4 py-3 text-status-warning-fg")" role="@(owners.Over ? "alert" : null)">@warning</p>
                }
                @if (owners.Owners.Count == 0)
                {
                    <p class="text-text-muted">No owners yet.</p>
                }
                else
                {
                    <ul class="card grid !p-0">
                        @foreach (var owner in owners.Owners)
                        {
                            <li class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-border-subtle px-4 py-3 last:border-b-0">
                                <span class="grid min-w-0 flex-1">
                                    <span class="font-strong">@owner.Name@(owner.IsHouse ? " (house share)" : null)</span>
                                    <span class="truncate text-small text-text-muted">@string.Join(" · ", new[] { owner.Email, owner.Mobile }.Where(c => c is not null))</span>
                                </span>
                                @if (owner.Invited is not null)
                                {
                                    <span class="badge bg-surface-sunken text-text-muted">@owner.Invited</span>
                                }
                                @if (owner.ToConfirm)
                                {
                                    @* Linked by the Relenta import: no access or updates until their share is set. *@
                                    <span class="badge bg-status-warning-bg text-status-warning-fg">Share to confirm</span>
                                    @if (CanManage && _horse.Managed)
                                    {
                                        <form class="flex items-center gap-2" @onsubmit="() => ConfirmAsync(owner)" @onsubmit:preventDefault>
                                            <label class="sr-only" for="confirm-@owner.PartyId">@owner.Name's share (%)</label>
                                            <input id="confirm-@owner.PartyId" class="input min-h-[36px] w-[6rem]" type="number" min="0.1" max="100" step="0.1" placeholder="%"
                                                   @bind="_confirmPercent[owner.PartyId]" />
                                            <button type="submit" class="btn-secondary min-h-[36px] px-3" disabled="@_busy">Set share</button>
                                        </form>
                                    }
                                    continue;
                                }
                                <span class="w-[64px] text-right font-strong tabular-nums">@owner.Percent</span>
                                <span class="text-small text-text-muted">since @owner.Since</span>
                                @if (CanManage && _horse.Managed)
                                {
                                    <button type="button" class="text-small font-strong underline underline-offset-4" aria-label="Change @owner.Name's share"
                                            @onclick="() => (_changing, _addingOwner, _ending, _ownerAdded) = (owner.PartyId, false, false, null)">Change</button>
                                }
                            </li>
                        }
                    </ul>
                }

                @if (_changing is { } changing && owners.Owners.FirstOrDefault(o => o.PartyId == changing) is { } changed)
                {
                    <OwnershipChange HorseId="Id" Owner="changed" HasHouse="@owners.Owners.Any(o => o.IsHouse)" OnDone="OwnershipChangedAsync" OnCancel="() => _changing = null" />
                }

                @if (CanManage && _horse.Managed)
                {
                    @if (!_addingOwner)
                    {
                        <button type="button" class="btn-secondary justify-self-start" @onclick="() => (_addingOwner, _ownerError) = (true, null)">Add an owner</button>
                    }
                    else
                    {
                        <form class="card grid gap-4" @onsubmit="AddOwnerAsync" @onsubmit:preventDefault aria-label="Add an owner">
                            <div class="grid gap-4 sm:grid-cols-2">
                                <div class="field sm:col-span-2">
                                    <label class="field-label" for="owner-name">Name</label>
                                    <input id="owner-name" class="input" maxlength="200" @bind="_ownerName" />
                                </div>
                                <div class="field">
                                    <label class="field-label" for="owner-email">Email</label>
                                    <input id="owner-email" class="input" type="email" @bind="_ownerEmail" />
                                </div>
                                <div class="field">
                                    <label class="field-label" for="owner-mobile">Mobile</label>
                                    <input id="owner-mobile" class="input" type="tel" @bind="_ownerMobile" placeholder="04xx xxx xxx" />
                                </div>
                                <div class="field">
                                    <label class="field-label" for="owner-share">Share (%)</label>
                                    <input id="owner-share" class="input" type="number" min="0.1" max="100" step="0.1" @bind="_ownerShare" />
                                    <span class="field-hint">@owners.Unallocated.ToString("0.#")% still unallocated.</span>
                                </div>
                                <div class="field">
                                    <label class="field-label" for="owner-since">Owner since</label>
                                    <input id="owner-since" class="input" type="date" @bind="_ownerSince" />
                                </div>
                            </div>
                            <p class="field-hint">Someone already known by their email is linked, not added twice. A new owner is sent their invitation to the owners' portal.</p>
                            @if (_ownerError is not null)
                            {
                                <p class="alert-danger" role="alert">@_ownerError</p>
                            }
                            <div class="flex flex-wrap gap-3">
                                <button type="submit" class="btn-primary" disabled="@_busy">Add owner</button>
                                <button type="button" class="btn-secondary" @onclick="() => _addingOwner = false">Cancel</button>
                            </div>
                        </form>
                    }
                }
                @if (_ownerAdded is not null)
                {
                    <p class="rounded-control bg-status-success-bg px-4 py-3 text-status-success-fg" role="status">@_ownerAdded</p>
                }
                @if (_ownerError is not null && !_addingOwner)
                {
                    <p class="alert-danger" role="alert">@_ownerError</p>
                }

                @if (CanManage && _horse.Managed)
                {
                    @* The horse leaves (sold, retired): every owner stops together; its history stays (scenario 3b). *@
                    @if (!_ending)
                    {
                        <button type="button" class="justify-self-start text-small underline underline-offset-4" @onclick="() => (_ending, _changing, _addingOwner, _endError) = (true, null, false, null)">
                            @_horse.Name is leaving management…
                        </button>
                    }
                    else
                    {
                        <form class="card grid gap-4 border-status-warning-fg" @onsubmit="EndAsync" @onsubmit:preventDefault aria-label="Leaving management">
                            <h3 class="text-title">@_horse.Name leaves management</h3>
                            <p>Every owner stops owning on that day. The horse and its history stay, and can be taken on again later.</p>
                            <div class="grid gap-4 sm:grid-cols-2">
                                <div class="field sm:col-span-2">
                                    <label class="field-label" for="end-reason">Why</label>
                                    <input id="end-reason" class="input" maxlength="200" @bind="_endReason" placeholder="Sold to a stud in Victoria" />
                                </div>
                                <div class="field">
                                    <label class="field-label" for="end-on">On</label>
                                    <input id="end-on" class="input" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" @bind="_endOn" />
                                </div>
                                <fieldset class="grid gap-2">
                                    <legend class="field-label mb-1">Afterwards, the owners</legend>
                                    <label class="inline-flex items-center gap-2"><input type="radio" name="end-access" class="size-[18px] accent-action-primary-bg" checked="@(!_endReadOnly)" @onchange="() => _endReadOnly = false" /> No longer see the horse</label>
                                    <label class="inline-flex items-center gap-2"><input type="radio" name="end-access" class="size-[18px] accent-action-primary-bg" checked="@_endReadOnly" @onchange="() => _endReadOnly = true" /> Can still read its history</label>
                                </fieldset>
                            </div>
                            @if (_endError is not null)
                            {
                                <p class="alert-danger" role="alert">@_endError</p>
                            }
                            <div class="flex flex-wrap gap-3">
                                <button type="submit" class="btn-primary" disabled="@_busy">@_horse.Name leaves management</button>
                                <button type="button" class="btn-secondary" @onclick="() => _ending = false">Cancel</button>
                            </div>
                        </form>
                    }
                }
            </section>
        }

        @if (_onHorse is { Count: > 0 })
        {
            <section class="grid grid-cols-[minmax(0,1fr)] gap-3" aria-labelledby="on-horse-heading">
                <h2 id="on-horse-heading">On the horse, not on an event</h2>
                <p class="text-small text-text-muted">Mail to @_horse.Name's address when no event was open, and mail left here from the queue. Staff only.</p>
                @foreach (var item in _onHorse)
                {
                    <article class="card grid gap-2">
                        <p class="text-small text-text-muted">@(item.Author ?? "Unknown sender") · @item.At@(item.Channel is null ? null : $" · by {item.Channel.ToLowerInvariant()}")</p>
                        @if (item.Title is not null)
                        {
                            <p class="font-strong">@item.Title</p>
                        }
                        <p class="line-clamp-2 whitespace-pre-line break-words">@item.Body</p>
                        @if (item.Media is { Count: > 0 } media)
                        {
                            <MediaGallery Media="media" Describe="@(item.Title ?? _horse.Name)" />
                            <p class="text-small text-text-muted">Staff only. Place it on an event to share @(media.Count == 1 ? "it" : "them") with the owners.</p>
                        }
                        @foreach (var reply in item.Replies ?? [])
                        {
                            <div class="ml-4 grid gap-1 border-l-2 border-border-subtle pl-3">
                                <p class="text-small text-text-muted">@reply.Author · @reply.At</p>
                                <p class="whitespace-pre-line break-words">@reply.Body</p>
                            </div>
                        }
                        @if (item.CanReplyToSender)
                        {
                            <ReplyToSender ItemId="item.Id" Author="@item.Author" OnSent="ReloadOnHorseAsync" />
                        }
                    </article>
                }
            </section>
        }

        <section class="grid grid-cols-[minmax(0,1fr)] gap-4" aria-labelledby="events-heading">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 id="events-heading">Events</h2>
                @if (!_creating)
                {
                    <button type="button" class="btn-primary" @onclick="StartCreating">New event</button>
                }
            </div>

            @if (_creating && _types is not null)
            {
                <form class="card grid gap-4" @onsubmit="CreateAsync" @onsubmit:preventDefault aria-labelledby="new-event-heading">
                    <h3 id="new-event-heading" class="font-heading">New event for @_horse.Name</h3>
                    <fieldset class="grid gap-2">
                        <legend class="field-label mb-2">What kind</legend>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var type in _types)
                            {
                                var selected = _type?.Code == type.Code;
                                <label class="inline-flex min-h-control cursor-pointer items-center gap-2 rounded-control border px-4 @(selected ? "border-action-primary-bg bg-action-secondary-bg font-strong" : "border-border-strong")">
                                    <input type="radio" name="event-type" class="size-[18px] accent-action-primary-bg" checked="@selected" @onchange="() => _type = type" />
                                    @type.Name
                                </label>
                            }
                        </div>
                    </fieldset>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="field">
                            <label class="field-label" for="event-title">Title</label>
                            <input id="event-title" class="input" @bind="_title" placeholder="@(_type?.TitleExample)" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="event-date">@(_type?.KeyDateLabel ?? "Date")</label>
                            <input id="event-date" class="input" type="date" @bind="_date" @bind:format="yyyy-MM-dd" />
                        </div>
                    </div>
                    <label class="inline-flex min-h-control cursor-pointer items-center gap-2">
                        <input type="checkbox" class="size-[18px] accent-action-primary-bg" @bind="_openNow" />
                        Open it now, so owners can see it
                    </label>
                    <p class="field-hint">@(_openNow ? "Owners see it on their timeline straight away; nothing is sent until you write to them." : "Saved as a draft: owners can't see it and nothing can be sent from it until you open it.")</p>
                    @if (_createError is not null)
                    {
                        <Error Message="@_createError" />
                    }
                    <div class="flex flex-wrap gap-3">
                        <button type="submit" class="btn-primary" disabled="@_busy">@(_openNow ? "Create and open" : "Save as draft")</button>
                        <button type="button" class="btn-secondary" @onclick="() => _creating = false">Cancel</button>
                    </div>
                </form>
            }
            @if (_events is { Count: 0 })
            {
                <div class="card"><p>No events yet for @_horse.Name.</p></div>
            }
            else if (_events is not null)
            {
                @foreach (var e in _events)
                {
                    <EventCard Model='e.ToCard($"events/{e.Id}")' />
                }
            }
        </section>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private HorseDetail? _horse;
    private List<EventSummary>? _events;
    private OwnersView? _owners;
    private bool _addingOwner;
    private string? _ownerName, _ownerEmail, _ownerMobile, _ownerError, _ownerAdded;
    private decimal? _ownerShare;
    private DateTime _ownerSince = DateTime.Today;

    /// <summary>Who owns a horse is for managers and admins; coordinators see the list.</summary>
    private bool CanManage => Session.Current?.Role is "Manager" or "TenantAdmin";

    private Guid? _changing;
    private readonly Dictionary<Guid, decimal?> _confirmPercent = new();

    /// <summary>A share to confirm gets its size: they own it now, see the horse, and are invited.</summary>
    private async Task ConfirmAsync(OwnerLine owner)
    {
        if (_confirmPercent.GetValueOrDefault(owner.PartyId) is not { } percent || percent <= 0) { _ownerError = "Give their share as a percentage."; return; }
        (_busy, _ownerError, _ownerAdded) = (true, null, null);
        try
        {
            var result = await Api.ConfirmShareAsync(Id, owner.PartyId, percent);
            if (!result.Succeeded) { _ownerAdded = null; _ownerError = result.Error; _addingOwner = false; return; }
            _ownerAdded = $"{owner.Name} now owns {percent:0.#}%. Their invitation to the owners' portal is on its way.";
            _owners = (await Api.HorseOwnersAsync(Id)).Value;
        }
        finally
        {
            _busy = false;
        }
    }
    private bool _ending, _endReadOnly;
    private string? _endReason, _endError;
    private DateTime _endOn = DateTime.Today;

    private async Task OwnershipChangedAsync(string message)
    {
        (_changing, _ownerAdded) = (null, message);
        _owners = (await Api.HorseOwnersAsync(Id)).Value;
    }

    private async Task EndAsync()
    {
        (_endError, _busy) = (null, true);
        try
        {
            var result = await Api.EndManagementAsync(Id, _endReason ?? "", _endOn.ToString("yyyy-MM-dd"), _endReadOnly ? "ReadOnly" : "LockedOut");
            if (!result.Succeeded) { _endError = result.Error; return; }
            _ending = false;
            _ownerAdded = $"{_horse!.Name} has left management. Its owners are now past owners.";
            _horse = (await Api.HorseAsync(Id)).Value ?? _horse;
            _owners = (await Api.HorseOwnersAsync(Id)).Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddOwnerAsync()
    {
        (_ownerError, _ownerAdded) = (null, null);
        if (_ownerShare is not > 0) { _ownerError = "Give their share as a percentage."; return; }
        _busy = true;
        try
        {
            var result = await Api.AddOwnerAsync(Id, _ownerName ?? "", _ownerEmail, _ownerMobile, _ownerShare.Value, _ownerSince.ToString("yyyy-MM-dd"));
            if (!result.Succeeded) { _ownerError = result.Error; return; }
            _ownerAdded = result.Value!.IsNew
                ? $"{_ownerName} added with {_ownerShare:0.#}%. Their invitation to the owners' portal is on its way."
                : $"{_ownerName} was already known here, so their new {_ownerShare:0.#}% is linked to them.";
            (_addingOwner, _ownerName, _ownerEmail, _ownerMobile, _ownerShare) = (false, null, null, null, null);
            _owners = (await Api.HorseOwnersAsync(Id)).Value;
        }
        finally
        {
            _busy = false;
        }
    }
    private string? _error;
    private bool _copied;
    private List<HorseItem>? _onHorse;

    private async Task ReloadOnHorseAsync() => _onHorse = (await Api.OnTheHorseAsync(Id)).Value;
    private bool _creating;
    private bool _busy;
    private bool _openNow = true;
    private List<EventTypeOption>? _types;
    private EventTypeOption? _type;
    private string? _title;
    private DateOnly? _date;
    private string? _createError;

    private async Task StartCreating()
    {
        _types ??= (await Api.EventTypesAsync()).Value ?? [];
        _type ??= _types.FirstOrDefault();
        (_creating, _createError) = (true, null);
    }

    private async Task CreateAsync()
    {
        _createError = _type is null ? "Choose what kind of event it is." : string.IsNullOrWhiteSpace(_title) ? $"Give it a title, for example \"{_type.TitleExample}\"." : null;
        if (_createError is not null) return;

        _busy = true;
        try
        {
            var result = await Api.CreateEventAsync(Id, _type!.Code, _title!.Trim(), _date?.ToString("yyyy-MM-dd"), _openNow);
            if (!result.Succeeded) { _createError = result.Error; return; }
            Navigation.NavigateTo($"events/{result.Value!.Id}");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Copy(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        _copied = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Session.Current is null && await Session.RefreshAsync() is null)
        {
            Navigation.NavigateTo("sign-in");
            return;
        }

        var horse = await Api.HorseAsync(Id);
        if (!horse.Succeeded) { _error = horse.Error; return; }
        _horse = horse.Value;

        _onHorse = (await Api.OnTheHorseAsync(Id)).Value;
        _owners = (await Api.HorseOwnersAsync(Id)).Value;
        var events = await Api.HorseEventsAsync(Id);
        if (events.Succeeded) { _events = events.Value; Rail.Show(StaffRail.From(_horse!, _events!, null)); }
        else _error = events.Error;
    }
}
