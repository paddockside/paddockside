@page "/forgot-password"
@inject PaddocksideApi Api

@*
    Staff "Forgot your password?". The answer is the same whether or not the address has an account, so this page
    never tells anyone who works where. The emailed link opens /reset-password.
*@
<PageTitle>Forgot your password · Paddockside</PageTitle>

<div class="card mx-auto grid max-w-md gap-4">
    <h1>Forgot your password?</h1>
    @if (_sent)
    {
        <p role="status">If <strong>@_email</strong> belongs to a Paddockside staff sign-in, we've emailed it a link to choose a new password.</p>
        <p class="text-text-muted">The link works once, for 30 minutes. If nothing arrives in a few minutes, check your junk folder, then try again.</p>
        <a href="sign-in" class="btn-secondary justify-self-start">Back to sign in</a>
    }
    else
    {
        <p class="text-text-muted">Type the email address you sign in with. We'll email you a link to choose a new password. You'll still need your authenticator app afterwards.</p>
        <form class="grid gap-4" @onsubmit="SendAsync" @onsubmit:preventDefault>
            <div class="field">
                <label class="field-label" for="email">Email</label>
                <input id="email" class="input" type="email" autocomplete="username" @bind="_email" required />
            </div>
            <Error Message="@_error" />
            <button type="submit" class="btn-primary w-full" disabled="@_busy">Email me a link</button>
        </form>
        <a href="sign-in" class="btn-link justify-self-start">Back to sign in</a>
        <p class="text-small text-text-muted">Owners don't have a password: use "Email me a link" on the owners' sign-in page instead.</p>
    }
</div>

@code {
    private string? _email;
    private string? _error;
    private bool _busy;
    private bool _sent;

    private async Task SendAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_email)) { _error = "Type your email address first."; return; }

        _busy = true;
        try
        {
            var result = await Api.ForgotPasswordAsync(_email.Trim());
            if (result.Succeeded) _sent = true;
            else _error = result.Error;
        }
        finally
        {
            _busy = false;
        }
    }
}
