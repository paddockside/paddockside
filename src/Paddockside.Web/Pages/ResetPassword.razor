@page "/reset-password"
@inject PaddocksideApi Api
@inject NavigationManager Navigation

@*
    Choosing a new password from an emailed link. The token is after "#", so it never reaches a server log. Opening
    the page does not use the link up; only a password the rules accept does. Then sign in as usual, authenticator
    included.
*@
<PageTitle>Choose a new password · Paddockside</PageTitle>

<div class="card mx-auto grid max-w-md gap-4">
    <h1>Choose a new password</h1>
    @if (_done)
    {
        <p role="status">Your password is changed, and any other devices you were signed in on have been signed out.</p>
        <a href="sign-in" class="btn-primary justify-self-start">Sign in</a>
    }
    else if (_gone is not null)
    {
        <Error Message="@_gone" />
        <a href="forgot-password" class="btn-primary justify-self-start">Ask for a new link</a>
    }
    else if (!_checked)
    {
        <p class="text-text-muted" role="status">Checking your link…</p>
    }
    else
    {
        <form class="grid gap-4" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <div class="field">
                <label class="field-label" for="password">New password</label>
                <p class="field-hint">At least 12 characters. A short phrase is easiest to remember, such as four unrelated words.</p>
                <input id="password" class="input" type="password" autocomplete="new-password" @bind="_password" required />
            </div>
            <div class="field">
                <label class="field-label" for="confirm">Type it again</label>
                <input id="confirm" class="input" type="password" autocomplete="new-password" @bind="_confirm" required />
            </div>
            <Error Message="@_error" />
            <button type="submit" class="btn-primary w-full" disabled="@_busy">Save my new password</button>
        </form>
    }
</div>

@code {
    private string _token = "";
    private bool _checked;
    private bool _done;
    private bool _busy;
    private string? _gone;
    private string? _error;
    private string? _password;
    private string? _confirm;

    protected override async Task OnInitializedAsync()
    {
        _token = new Uri(Navigation.Uri).Fragment.TrimStart('#');
        var check = _token.Length == 0 ? null : await Api.CheckResetLinkAsync(_token);
        if (check is not { Succeeded: true }) _gone = check?.Error ?? "This link is incomplete. Open it from the email again, or ask for a new one.";
        _checked = true;
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrEmpty(_password)) { _error = "Type your new password."; return; }
        if (_password != _confirm) { _error = "The two passwords are different. Type them again."; return; }

        _busy = true;
        try
        {
            var result = await Api.ResetPasswordAsync(_token, _password);
            if (result.Succeeded) (_done, _password, _confirm) = (true, null, null);
            else if (result.Status == System.Net.HttpStatusCode.Gone) _gone = result.Error;
            else _error = result.Error;
        }
        finally
        {
            _busy = false;
        }
    }
}
