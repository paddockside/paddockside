@page "/inbound"
@inject PaddocksideApi Api
@inject SessionState Session
@inject NavigationManager Navigation

@*
    Inbound mail (messaging-channels.md §3.2) and the pending queue (search-reporting.md §3). "Waiting" is the
    queue, oldest first: mail that reached a general address, with the matcher's suggestion and its reasons, and
    one-click confirm, choose a horse and event, leave it on the horse, ignore, or spam. Placed shows where each
    email went and why; Ignored is automatic mail; Held (spam) is for tenant admins only.
*@

<PageTitle>Inbound mail · Paddockside</PageTitle>

<div class="grid grid-cols-[minmax(0,1fr)] gap-4">
    <h1>Inbound mail</h1>

    @if (_counts is not null)
    {
        <div class="flex flex-wrap gap-2" role="group" aria-label="Show">
            @foreach (var (state, label, count) in Tabs())
            {
                <button type="button" class="@(state == _state ? "btn-primary" : "btn-secondary")" aria-pressed="@(state == _state)"
                        @onclick="() => ShowAsync(state)">
                    @label (@count)
                </button>
            }
        </div>
        <p class="text-text-muted">@Explanation(_state)</p>
        @if (_state == "Waiting" && (_counts.Ages is not null || _counts.MedianToPlace is not null))
        {
            <p class="text-small text-text-muted">@string.Join(" · ", new[] { _counts.Ages, _counts.MedianToPlace }.OfType<string>())</p>
        }
    }

    @if (_notice is not null)
    {
        <p class="rounded-control bg-status-success-bg px-4 py-3 text-status-success-fg" role="status">@_notice</p>
    }
    @if (_error is not null)
    {
        <Error Message="@_error" />
    }
    else if (_messages is null)
    {
        <p class="text-text-muted" role="status">Loading…</p>
    }
    else if (_messages.Count == 0)
    {
        <div class="card"><p>@(_state == "Waiting" ? "Nothing waiting. Every email so far went where it belonged." : "Nothing here.")</p></div>
    }
    else
    {
        <ol class="grid grid-cols-[minmax(0,1fr)] gap-4">
            @foreach (var m in _messages)
            {
                <li class="card grid gap-3">
                    <div class="flex flex-wrap items-baseline gap-2">
                        <h2 class="font-heading">@(m.Subject ?? (m.Channel == "Sms" ? "Text message" : "(no subject)"))</h2>
                        <span class="ml-auto text-small text-text-muted">@(m.Waiting ?? m.Received)</span>
                    </div>
                    <p class="break-words text-small text-text-muted">From @m.From · to @m.To</p>

                    @if (!string.IsNullOrWhiteSpace(m.Body))
                    {
                        <div class="whitespace-pre-line break-words rounded-control bg-surface-sunken p-3">@m.Body</div>
                    }
                    @if (m.Attachments.Count > 0)
                    {
                        <ul class="text-small text-text-muted">
                            @foreach (var a in m.Attachments)
                            {
                                <li>📎 @a.Name@(a.Dropped is null ? null : $" — {a.Dropped}")</li>
                            }
                        </ul>
                    }

                    @if (_state == "Waiting")
                    {
                        @Queue(m)
                    }
                    else
                    {
                        @if (m.Reason is not null)
                        {
                            <p class="text-small">@m.Reason</p>
                        }
                        @if (m.HorseId is not null)
                        {
                            <p class="text-small">
                                On
                                @if (m.EventId is not null)
                                {
                                    <a href="events/@m.EventId" class="underline underline-offset-4">@m.Horse · @m.Event</a>
                                }
                                else
                                {
                                    <a href="horses/@m.HorseId" class="underline underline-offset-4">@m.Horse (no event)</a>
                                }
                            </p>
                        }
                    }
                </li>
            }
        </ol>
    }
</div>

@code {
    private string _state = "Waiting";
    private InboundCounts? _counts;
    private List<InboundView>? _messages;
    private List<PlaceOption>? _places;
    private string? _error;
    private string? _notice;
    private Guid? _busy;

    /// <summary>Staff's own choice per message, before placing: the horse, then the event ("" = on the horse).</summary>
    private readonly Dictionary<Guid, (Guid? Horse, string Event)> _choice = [];

    /// <summary>The queue's controls for one message: the suggestion, the other guesses, a choice of any horse and event, and dismissing.</summary>
    private RenderFragment Queue(InboundView m) => __builder =>
    {
        var others = (m.Candidates ?? []).Where(c => !(m.State == "Suggested" && c.HorseId == m.HorseId && c.EventId == m.EventId)).ToList();
        var choice = _choice.GetValueOrDefault(m.Id);
        var events = _places?.FirstOrDefault(p => p.HorseId == choice.Horse)?.Events ?? [];

        @if (m.State == "Suggested" && m.HorseId is { } suggestedHorse)
        {
            var suggestion = m.Candidates?.FirstOrDefault(c => c.HorseId == m.HorseId && c.EventId == m.EventId);
            <section class="grid gap-2 rounded-control border-2 border-action-primary-bg p-3" aria-label="Suggested place">
                <p><span class="text-small font-strong uppercase tracking-wide text-text-muted">Looks like</span><br />
                    <span class="font-strong">@m.Horse@(m.Event is null ? " (on the horse, no event)" : $" · {m.Event}")</span></p>
                @if (suggestion is not null)
                {
                    <ul class="list-disc pl-6 text-small">
                        @foreach (var reason in suggestion.Reasons)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                }
                <button type="button" class="btn-primary justify-self-start" disabled="@(_busy == m.Id)"
                        @onclick="() => PlaceAsync(m, suggestedHorse, m.EventId)">Confirm</button>
            </section>
        }
        else
        {
            <p class="text-small">@m.Reason</p>
        }

        @if (others.Count > 0)
        {
            <div class="grid gap-2">
                <p class="text-small text-text-muted">@(m.State == "Suggested" ? "Or one of these" : "Best guesses")</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var c in others)
                    {
                        <button type="button" class="btn-secondary whitespace-normal text-left" disabled="@(_busy == m.Id)" title="@string.Join("; ", c.Reasons)"
                                @onclick="() => PlaceAsync(m, c.HorseId, c.EventId)">@c.Horse@(c.Event is null ? " (on the horse)" : $" · {c.Event}")</button>
                    }
                </div>
            </div>
        }

        <details class="grid gap-3">
            <summary class="btn-link cursor-pointer">Choose a horse and event</summary>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
                <div class="field">
                    <label class="field-label" for="horse-@m.Id">Horse</label>
                    <select id="horse-@m.Id" class="input" @onchange="e => ChooseHorse(m.Id, e.Value?.ToString())">
                        <option value="">Choose…</option>
                        @foreach (var p in _places ?? [])
                        {
                            <option value="@p.HorseId" selected="@(choice.Horse == p.HorseId)">@p.Horse</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label class="field-label" for="event-@m.Id">Event</label>
                    <select id="event-@m.Id" class="input" disabled="@(choice.Horse is null)" @onchange="e => _choice[m.Id] = (choice.Horse, e.Value?.ToString() ?? string.Empty)">
                        <option value="">On the horse, not an event</option>
                        @foreach (var ev in events)
                        {
                            <option value="@ev.Id" selected="@(choice.Event == ev.Id.ToString())">@ev.Title · @ev.KeyDate</option>
                        }
                    </select>
                </div>
            </div>
            <button type="button" class="btn-secondary justify-self-start" disabled="@(choice.Horse is null || _busy == m.Id)"
                    @onclick="() => PlaceAsync(m, choice.Horse!.Value, Guid.TryParse(choice.Event, out var ev) ? ev : null)">Place it there</button>
        </details>

        <div class="flex flex-wrap gap-2 border-t border-border-subtle pt-3">
            <button type="button" class="btn-secondary" disabled="@(_busy == m.Id)" @onclick="() => DismissAsync(m, spam: false)">Ignore</button>
            <button type="button" class="btn-secondary" disabled="@(_busy == m.Id)" @onclick="() => DismissAsync(m, spam: true)">Spam</button>
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        if (await Session.RefreshAsync() is null)
        {
            Navigation.NavigateTo("sign-in");
            return;
        }

        await RefreshCountsAsync();
        await ShowAsync(_state);
    }

    private async Task RefreshCountsAsync()
    {
        var counts = await Api.InboundCountsAsync();
        if (counts.Succeeded) _counts = counts.Value;
    }

    private async Task ShowAsync(string state)
    {
        (_state, _messages, _error) = (state, null, null);
        if (state == "Waiting" && _places is null) _places = (await Api.InboundPlacesAsync()).Value ?? [];
        var result = await Api.InboundAsync(state);
        if (result.Succeeded) _messages = result.Value;
        else _error = result.Error;
    }

    private void ChooseHorse(Guid messageId, string? value) =>
        _choice[messageId] = (Guid.TryParse(value, out var horse) ? horse : null, string.Empty);

    private async Task PlaceAsync(InboundView m, Guid horseId, Guid? eventId)
    {
        (_busy, _error, _notice) = (m.Id, null, null);
        try
        {
            var result = await Api.PlaceInboundAsync(m.Id, horseId, eventId);
            if (!result.Succeeded) { _error = result.Error; return; }
            var horse = _places?.FirstOrDefault(p => p.HorseId == horseId);
            var where = eventId is { } e ? $"{horse?.Horse} · {horse?.Events.FirstOrDefault(x => x.Id == e)?.Title}" : $"{horse?.Horse} (on the horse)";
            _notice = $"Placed \"{m.Subject ?? "the message"}\" on {where}. Staff only until you share it.";
            _messages!.Remove(m);
            await RefreshCountsAsync();
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task DismissAsync(InboundView m, bool spam)
    {
        (_busy, _error, _notice) = (m.Id, null, null);
        try
        {
            var result = await Api.DismissInboundAsync(m.Id, spam);
            if (!result.Succeeded) { _error = result.Error; return; }
            _notice = spam ? "Marked as spam. Tenant admins can still see it under Held." : "Ignored. It stays under Automatic mail and is never placed.";
            _messages!.Remove(m);
            await RefreshCountsAsync();
        }
        finally
        {
            _busy = null;
        }
    }

    private IEnumerable<(string State, string Label, int Count)> Tabs()
    {
        yield return ("Waiting", "Waiting to be placed", _counts!.Waiting);
        yield return ("Placed", "Placed", _counts.Placed);
        yield return ("Ignored", "Ignored and automatic", _counts.Ignored);
        if (_counts.Held is { } held) yield return ("Held", "Held as spam", held);
    }

    private static string Explanation(string state) => state switch
    {
        "Waiting" => "Mail that reached a general address, oldest first. Where we can tell where it belongs, you'll see a suggestion and why: confirm it, or choose another place.",
        "Placed" => "Replies threaded under their message, mail to a horse's own address, and mail placed from the queue.",
        "Ignored" => "Out-of-office replies, auto-responders, bounces, and mail staff chose to ignore. Never placed, never answered.",
        _ => "Spam, as judged by the mail provider or by staff. Only tenant admins see these.",
    };
}
