@page "/social/{Id:guid}"
@inject PaddocksideApi Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@(_event?.Event.Title ?? "Social event") · Paddockside</PageTitle>

@*
    One social event (David, 22 and 25 Nov 2026): when and where, the places taken, and one list of people in the order
    things happen to them. "Add people" puts clients or a whole client list on it, which emails nobody; "Send invitations"
    shows the email and who it goes to, and sends it to everyone not invited yet; they move to "Invited", with where their
    email got to, and their answer from its buttons. Adding more later never invites anyone twice.
*@
<div class="grid grid-cols-[minmax(0,1fr)] gap-6">
    <a href="social" class="btn-link justify-self-start">← Social</a>

    @if (_error is not null)
    {
        <Error Message="@_error" />
    }
    else if (_event is null)
    {
        <p class="text-text-muted" role="status">Loading…</p>
    }
    else
    {
        var e = _event.Event;
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="grid min-w-0 gap-1">
                <h1>@e.Title</h1>
                <p class="text-text-muted">@e.KindLabel · @e.When@(e.Venue is null ? null : $" · {e.Venue}")</p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                @if (e.Status != "Open")
                {
                    <span class="badge bg-surface-sunken text-text-muted">@e.Status</span>
                }
                @if (CanEdit && !_editing)
                {
                    <button type="button" class="btn-secondary min-h-[36px] px-4" @onclick="() => _editing = true">Change details</button>
                }
            </div>
        </div>

        @if (_editing)
        {
            <SocialForm Editing="_event" OnSaved="SavedAsync" OnCancel="() => _editing = false" />
        }

        @if (_saved is not null)
        {
            <p class="rounded-control bg-status-success-bg px-4 py-3 text-status-success-fg" role="status">@_saved</p>
        }

        <section class="grid gap-3 sm:grid-cols-4" aria-label="So far">
            <div class="card grid gap-1">
                <span class="text-small text-text-muted">@(e.Places is null ? "Coming" : "Places taken")</span>
                <span class="text-heading font-heading tabular-nums">@(e.Places is { } places ? $"{e.Coming} of {places}" : $"{e.Coming}")</span>
            </div>
            <div class="card grid gap-1">
                <span class="text-small text-text-muted">Waiting to hear</span>
                <span class="text-heading font-heading tabular-nums">@e.Invited</span>
            </div>
            <div class="card grid gap-1">
                <span class="text-small text-text-muted">Maybe · not coming</span>
                <span class="text-heading font-heading tabular-nums">@_event.Maybe · @_event.NotComing</span>
            </div>
            <div class="card grid gap-1">
                <span class="text-small text-text-muted">Waiting list (places)</span>
                <span class="text-heading font-heading tabular-nums">@e.Waiting</span>
            </div>
        </section>

        <section class="grid grid-cols-[minmax(0,1fr)] gap-3" aria-labelledby="to-invite-heading">
            <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 id="to-invite-heading">Not invited yet (@Waiting.Count)</h2>
                @if (CanEdit)
                {
                    <div class="flex flex-wrap gap-3">
                        @if (!_adding)
                        {
                            <button type="button" class="@(Waiting.Count == 0 ? "btn-primary" : "btn-secondary") min-h-[40px] px-4" @onclick="() => _adding = true">@(_event.Attendees.Count == 0 ? "Add people" : "Add more people")</button>
                        }
                        @if (e.Status == "Open" && Waiting.Any(a => a.CantEmail is null))
                        {
                            <button type="button" class="btn-primary min-h-[40px] px-4" disabled="@_busy" @onclick="OpenInvitationAsync">Send invitations…</button>
                        }
                    </div>
                }
            </div>

            @if (_adding)
            {
                <SocialAdd EventId="Id" On="_event.Attendees.Select(a => a.PartyId).ToHashSet()" OnDone="AddedAsync" />
            }

            @if (Waiting.Count > 0)
            {
                @Rows(Waiting)
            }
            else if (!_adding)
            {
                <p class="text-text-muted">@(_event.Attendees.Count == 0 ? "Nobody on the list yet. Add people or a client list, then send them the invitation." : "Everyone on the list has been invited or has answered.")</p>
            }
        </section>

        @if (Invited.Count > 0)
        {
            <section class="grid grid-cols-[minmax(0,1fr)] gap-3" aria-labelledby="invited-heading">
                <h2 id="invited-heading">Invited (@Invited.Count)</h2>
                @if (_event.Invitations.Count > 0)
                {
                    <p class="text-small text-text-muted">
                        @foreach (var i in _event.Invitations)
                        {
                            <a href="mailouts/@i.MailoutId" class="mr-4 inline-block underline underline-offset-4">Sent to @(i.Recipients == 1 ? "1 person" : $"{i.Recipients} people"), @Since(i.Sent)</a>
                        }
                    </p>
                }
                @Rows(Invited)
            </section>
        }

        @if (Others.Count > 0)
        {
            <section class="grid grid-cols-[minmax(0,1fr)] gap-3" aria-labelledby="others-heading">
                <h2 id="others-heading">Answered without an invitation (@Others.Count)</h2>
                @Rows(Others)
            </section>
        }

        @if (_event.Notes is { } notes)
        {
            <section class="card grid gap-1" aria-label="Notes">
                <h2 class="text-small font-strong uppercase tracking-wide text-text-muted">Notes for staff</h2>
                <p class="whitespace-pre-line">@notes</p>
            </section>
        }

        @if (CanEdit)
        {
            <div class="flex flex-wrap gap-4 text-small">
                @if (e.Status == "Open")
                {
                    <button type="button" class="underline underline-offset-4" disabled="@_busy" @onclick='() => StatusAsync("Closed")'>Close replies</button>
                    <button type="button" class="underline underline-offset-4" disabled="@_busy" @onclick='() => StatusAsync("Cancelled")'>Cancel the event</button>
                }
                else
                {
                    <button type="button" class="underline underline-offset-4" disabled="@_busy" @onclick='() => StatusAsync("Open")'>Open it again</button>
                }
            </div>
        }
    }
</div>

@if (_draft is { } draft && _event is { } shown)
{
    <SocialInvitation EventId="Id" EventTitle="@shown.Event.Title" Draft="draft" @bind-Subject="_subject" @bind-Body="_body" @bind-Signature="_signature" OnClose="SentAsync" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    private SocialDetail? _event;
    private string? _error, _saved, _note;
    private bool _editing, _adding, _busy;
    private Guid? _changing;
    private string _status = "Coming";
    private int _places = 1;
    private SocialInvitationDraft? _draft;
    private string _subject = "", _body = "", _signature = "";
    private bool _worded;

    private List<SocialAttendeeLine> Waiting => _event!.Attendees.Where(a => a.Unsent).ToList();

    private List<SocialAttendeeLine> Invited => _event!.Attendees.Where(a => !a.Unsent && a.Delivery is not null).ToList();

    /// <summary>On the list by hand, with an answer staff took down.</summary>
    private List<SocialAttendeeLine> Others => _event!.Attendees.Where(a => !a.Unsent && a.Delivery is null).ToList();

    private RenderFragment Rows(List<SocialAttendeeLine> people) => __builder =>
    {
        <ul class="card grid !p-0">
            @foreach (var a in people)
            {
                <li class="grid gap-1 border-b border-border-subtle px-4 py-3 last:border-b-0">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                        <a href="clients/@a.PartyId" class="font-strong underline-offset-4 hover:underline">@a.Name</a>
                        @if (a.CantEmail is { } why)
                        {
                            <span class="badge bg-status-warning-bg text-status-warning-fg">Can't be emailed: @why.ToLowerInvariant()</span>
                        }
                        else if (!a.Unsent)
                        {
                            <span class="badge @Badge(a.Status)">@(a.Status == "Invited" ? "No answer yet" : a.StatusLabel)</span>
                        }
                        @if (a.Status is "Coming" or "Waiting")
                        {
                            <span class="text-small tabular-nums">@(a.Places == 1 ? "1 place" : $"{a.Places} places")</span>
                        }
                        <span class="text-small sm:ml-auto @(a.Delivery == "Bounced" ? "font-strong text-status-danger-fg" : "text-text-muted")">@Happened(a)</span>
                    </div>
                    @if (a.Note is not null)
                    {
                        <p class="text-small text-text-muted">@a.Note</p>
                    }
                    @if (_changing == a.PartyId)
                    {
                        <form class="flex flex-wrap items-end gap-2" @onsubmit="() => SetAsync(a)" @onsubmit:preventDefault aria-label="@AnswerOf(a)">
                            <div class="field">
                                <label class="field-label" for="st-@a.PartyId">Answer</label>
                                <select id="st-@a.PartyId" class="input min-h-[36px] w-auto" @bind="_status">
                                    @foreach (var (answer, label) in Answers)
                                    {
                                        <option value="@answer">@label</option>
                                    }
                                </select>
                            </div>
                            <div class="field w-[6rem]">
                                <label class="field-label" for="pl-@a.PartyId">Places</label>
                                <input id="pl-@a.PartyId" class="input min-h-[36px]" type="number" min="1" max="20" @bind="_places" />
                            </div>
                            <div class="field min-w-0 flex-[1_1_12rem]">
                                <label class="field-label" for="nt-@a.PartyId">Note</label>
                                <input id="nt-@a.PartyId" class="input min-h-[36px]" maxlength="300" @bind="_note" />
                            </div>
                            <button type="submit" class="btn-secondary min-h-[36px] px-3" disabled="@_busy">Save</button>
                            <button type="button" class="min-h-[36px] text-small underline underline-offset-4" @onclick="() => _changing = null">Cancel</button>
                        </form>
                    }
                    else if (CanEdit)
                    {
                        <div class="flex flex-wrap gap-4">
                            <button type="button" class="text-small font-strong underline underline-offset-4" @onclick="() => StartChanging(a)">
                                @(a.Unsent ? "Record an answer" : "Change")<span class="sr-only"> for @a.Name</span>
                            </button>
                            <button type="button" class="text-small underline underline-offset-4" disabled="@_busy" @onclick="() => RemoveAsync(a)">
                                Take off<span class="sr-only"> @a.Name</span>
                            </button>
                        </div>
                    }
                </li>
            }
        </ul>
    };

    private static string AnswerOf(SocialAttendeeLine a) => $"{a.Name}'s answer";

    /// <summary>"replied today, 9:40 am", "set by staff…", or where the invitation got to.</summary>
    private static string Happened(SocialAttendeeLine a) =>
        a.AnsweredBy == "them" ? $"replied {Since(a.Updated)}"
        : a.AnsweredBy is not null ? $"set by staff {Since(a.Updated)}"
        : a.Unsent ? $"added {Since(a.Updated)}"
        : a.Delivery switch
        {
            "Sending" => "sending now",
            "Sent" => "email sent",
            "Delivered" => "email delivered",
            "Opened" => "email opened",
            "Bounced" => "email bounced",
            _ => "",
        };

    private static readonly (string, string)[] Answers =
        [("Coming", "Coming"), ("Maybe", "Maybe"), ("NotComing", "Not coming"), ("Waiting", "Waiting list"), ("Invited", "No answer yet")];

    private bool CanEdit => Session.Current?.Role is "Coordinator" or "Manager" or "TenantAdmin";

    /// <summary>"today, 9:40 am" reads on after "replied"; a day name keeps its capital.</summary>
    private static string Since(string at) => at.StartsWith("Today") || at.StartsWith("Yesterday") ? char.ToLowerInvariant(at[0]) + at[1..] : at;

    private static string Badge(string status) => status switch
    {
        "Coming" => "bg-status-success-bg text-status-success-fg",
        "Waiting" => "bg-status-warning-bg text-status-warning-fg",
        "NotComing" => "bg-surface-sunken text-text-muted",
        "Maybe" => "bg-status-info-bg text-status-info-fg",
        _ => "bg-surface-sunken text-text-primary",
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Session.Current is null && await Session.RefreshAsync() is null)
        {
            Navigation.NavigateTo("sign-in");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.SocialEventAsync(Id);
        if (result.Succeeded) _event = result.Value;
        else _error = result.Error;
    }

    private async Task SavedAsync(Guid _)
    {
        (_editing, _saved) = (false, "Saved.");
        await LoadAsync();
    }

    private async Task AddedAsync(SocialAdded? added)
    {
        _adding = false;
        if (added is null) return;
        var people = added.Count == 1 ? "1 person" : $"{added.Count} people";
        _saved = added.Count == 0 ? "Everyone you chose was already on the list."
            : $"Added {people}.{(added.Already > 0 ? $" {added.Already} already on the list." : "")} Nothing is emailed until you send the invitations.";
        await LoadAsync();
    }

    private async Task OpenInvitationAsync()
    {
        (_busy, _error, _saved) = (true, null, null);
        try
        {
            var result = await Api.InvitationDraftAsync(Id);
            if (!result.Succeeded) { _error = result.Error; return; }
            // Words typed and then "Not yet" are still there; who it goes to is always fresh.
            if (!_worded) (_subject, _body, _signature, _worded) = (result.Value!.Subject, result.Value.Body, result.Value.Signature, true);
            _draft = result.Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SentAsync(int? sent)
    {
        _draft = null;
        if (sent is not { } count) return;
        (_worded, _saved) = (false, $"Invitation sent to {(count == 1 ? "1 person" : $"{count} people")}. Their answers will show here.");
        await LoadAsync();
    }

    private void StartChanging(SocialAttendeeLine a) =>
        (_changing, _status, _places, _note) = (a.PartyId, a.Status == "Invited" ? "Coming" : a.Status, a.Places, a.Note);

    private async Task SetAsync(SocialAttendeeLine a)
    {
        _busy = true;
        try
        {
            var result = await Api.SetSocialAttendeeAsync(Id, a.PartyId, _status, _places, _note);
            if (!result.Succeeded) { _error = result.Error; return; }
            _changing = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(SocialAttendeeLine a)
    {
        _busy = true;
        try
        {
            var result = await Api.RemoveSocialAttendeeAsync(Id, a.PartyId);
            if (!result.Succeeded) { _error = result.Error; return; }
            (_changing, _saved) = (null, $"{a.Name} is off the list.");
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task StatusAsync(string status)
    {
        _busy = true;
        try
        {
            var result = await Api.SetSocialStatusAsync(Id, status);
            if (!result.Succeeded) { _error = result.Error; return; }
            _saved = status switch { "Closed" => "Replies are closed.", "Cancelled" => "Cancelled.", _ => "Open again." };
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
