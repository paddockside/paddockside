@page "/horses/{Id:guid}/update"
@layout FocusLayout
@implements IAsyncDisposable
@inject PaddocksideApi Api
@inject SessionState Session
@inject UpdateOutbox Outbox
@inject NavigationManager Navigation

@*
    Sending an update from a phone (David, 25 Nov 2026): the whole screen, the likeliest event already chosen, and four big
    ways to add to it: record a voice note here, the phone's own camera for video and photos, or anything already on the
    phone. Files go up while it's written and are kept on the phone until it's sent (UpdateOutbox). Then who it goes to, in
    a sheet, and Send. The settings a quick update doesn't need are under More options.
*@
<PageTitle>Update · @(_options?.Horse ?? "Paddockside")</PageTitle>

<div class="mx-auto flex min-h-screen max-w-2xl flex-col bg-surface-raised" style="min-height:100dvh">
    <header class="flex items-center gap-2 border-b border-border-subtle px-2 py-2">
        <button type="button" class="inline-flex min-h-[48px] items-center px-3 font-strong underline underline-offset-4" @onclick="BackAsync">@(_recording ? "Cancel" : "Back")</button>
        <h1 class="min-w-0 truncate text-title">@(_recording ? "Voice note" : _options is null ? "Update" : _options.Horse)</h1>
    </header>

    @if (_error is not null && _options is null)
    {
        <div class="p-4"><Error Message="@_error" /></div>
    }
    else if (_options is not { } options || Update is not { } update)
    {
        <p class="p-4 text-text-muted" role="status">Loading…</p>
    }
    else if (!options.Managed)
    {
        <p class="p-4">@options.Horse is no longer managed, so its updates have ended.</p>
    }
    else if (update.State is "sending" or "sent" || (update.State == "failed" && !_fixing))
    {
        @* Pressed Send: what's happening to it. They can go elsewhere; it carries on. *@
        <main class="grid flex-1 content-center gap-4 px-6 text-center" aria-live="polite">
            @if (update.State == "sent")
            {
                <h2 class="text-heading">@(update.Recipients == 0 ? "Added" : $"Sent to {Owners(update.Recipients)}")</h2>
                <p class="text-text-muted">@(update.Recipients == 0 ? "Nobody was emailed." : "Each gets it their own way, and their replies come back to the update.")</p>
            }
            else if (update.State == "failed")
            {
                <h2 class="text-heading">It hasn't been sent</h2>
                <p class="alert-danger" role="alert">@update.Error</p>
            }
            else
            {
                <h2 class="text-heading">@(Outbox.State.NeedsSignIn ? "Sign in to send it" : Outbox.State.Online ? "Sending…" : "Waiting for signal")</h2>
                @if (update.Files.Count > 0)
                {
                    <div class="mx-auto h-[10px] w-full max-w-sm overflow-hidden rounded-pill bg-surface-sunken" role="progressbar" aria-valuenow="@update.Percent" aria-valuemin="0" aria-valuemax="100" aria-label="Sent so far">
                        <div class="h-full bg-action-primary-bg" style="width:@(update.Percent)%"></div>
                    </div>
                    <p class="tabular-nums">@update.Percent%</p>
                }
                <p class="text-text-muted">@(update.Unkept ? "Keep this page open until it's gone: this phone won't keep it otherwise." : "It's kept on this phone until it's gone. Use Paddockside as usual; if you close it, it carries on when you open it again.")</p>
            }
        </main>
        <footer class="grid gap-3 border-t border-border-subtle p-4">
            @if (update.State == "sent")
            {
                <button type="button" class="btn-primary min-h-[52px] w-full" @onclick="ViewAsync">See the update</button>
                <button type="button" class="btn-secondary min-h-[52px] w-full" @onclick="AnotherAsync">Another horse</button>
            }
            else if (update.State == "failed")
            {
                <button type="button" class="btn-primary min-h-[52px] w-full" @onclick="() => _fixing = true">Fix it and send again</button>
                <button type="button" class="btn-secondary min-h-[52px] w-full" @onclick="AnotherAsync">Later</button>
            }
            else
            {
                @if (Outbox.State.NeedsSignIn)
                {
                    <a href="sign-in" class="btn-primary min-h-[52px] w-full">Sign in</a>
                }
                else if (!Outbox.State.Online)
                {
                    <button type="button" class="btn-primary min-h-[52px] w-full" @onclick="Outbox.RetryAsync">Try now</button>
                }
                <button type="button" class="btn-secondary min-h-[52px] w-full" @onclick="AnotherAsync">Another horse</button>
                <button type="button" class="min-h-[48px] underline underline-offset-4" @onclick="EditAsync">Stop and change it</button>
            }
        </footer>
    }
    else
    {
        @* Recording covers the form; the form stays, so nothing typed or chosen is lost. *@
        <div class="@(_recording ? "flex" : "hidden") flex-1 flex-col">
            <main class="grid flex-1 content-center justify-items-center gap-4 px-6 text-center">
                <span @ref="_clock" class="text-heading tabular-nums" role="timer" aria-label="Length so far">0:00</span>
                <canvas @ref="_canvas" class="h-[72px] w-full max-w-sm text-action-primary-bg" aria-hidden="true"></canvas>
                <p class="text-text-muted" role="status">@(_paused ? "Paused" : "Recording")</p>
            </main>
            <footer class="grid gap-3 border-t border-border-subtle p-4">
                <div class="grid grid-cols-2 gap-3">
                    <button type="button" class="btn-secondary min-h-[52px]" @onclick="PauseAsync">@(_paused ? "Continue" : "Pause")</button>
                    <button type="button" class="btn-secondary min-h-[52px]" @onclick="RestartAsync">Start again</button>
                </div>
                <button type="button" class="btn-primary min-h-[56px] w-full" @onclick="DoneAsync">Done</button>
            </footer>
        </div>

        <div class="@(_recording ? "hidden" : "flex") flex-1 flex-col">
            <main class="grid flex-1 content-start gap-4 p-4">
                <div class="field">
                    <label class="field-label" for="about">About</label>
                    <select id="about" class="input min-h-[52px]" value="@EventKey" @onchange="ChooseEvent">
                        @foreach (var e in options.Events)
                        {
                            <option value="@(e.Id?.ToString() ?? "")">@e.Title@(e.Id is null || e.When.Length == 0 ? null : $" · {e.When}")</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label class="sr-only" for="words">@(update.Files.Count > 0 ? "Words to go with it" : "Message")</label>
                    <textarea id="words" class="input min-h-[120px] py-3" maxlength="4000" placeholder="@(update.Files.Count > 0 ? "Add a few words, if you like" : "Write something, or just record it")" @bind="_body" @bind:event="oninput" @bind:after="SaveSoon"></textarea>
                </div>

                <div class="grid grid-cols-4 gap-2" role="group" aria-label="Add to this update">
                    <button type="button" class="@Tile" @onclick="RecordAsync">@Icon("M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zM5 11a7 7 0 0 0 14 0M12 18v3")Voice</button>
                    <label class="@Tile focus-within:outline focus-within:outline-2 focus-within:outline-offset-2">@Icon("M3 6h12v12H3zM15 10l6-3v10l-6-3z")Video<input @ref="_video" type="file" accept="video/*" capture="environment" class="sr-only" /></label>
                    <label class="@Tile focus-within:outline focus-within:outline-2 focus-within:outline-offset-2">@Icon("M4 8h3l2-3h6l2 3h3v11H4zM12 17a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z")Photo<input @ref="_photo" type="file" accept="image/*" capture="environment" class="sr-only" /></label>
                    <label class="@Tile focus-within:outline focus-within:outline-2 focus-within:outline-offset-2">@Icon("M3 5h18v14H3zM21 15l-5-5L6 19M8.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z")Choose<input @ref="_choose" type="file" multiple accept="image/*,video/*,audio/*,.heic,.m4a,.mov" class="sr-only" /></label>
                </div>

                @if (_voiceProblem is not null || update.Error is not null)
                {
                    <p class="alert-danger" role="alert">@(_voiceProblem ?? update.Error)</p>
                }

                @if (update.Files.Count > 0)
                {
                    <ul class="grid gap-3" aria-label="On this update">
                        @foreach (var f in update.Files)
                        {
                            <li @key="f.Key" class="grid gap-2 rounded-card border border-border-subtle p-3">
                                @if (f.Url is not null && f.Kind == "Photo")
                                {
                                    <img src="@f.Url" alt="@f.Name" class="max-h-[240px] w-full rounded-control bg-surface-sunken object-contain" />
                                }
                                else if (f.Url is not null && f.Kind == "Video")
                                {
                                    <video src="@f.Url" controls playsinline preload="metadata" class="max-h-[240px] w-full rounded-control bg-surface-sunken" aria-label="@f.Name"></video>
                                }
                                else if (f.Url is not null)
                                {
                                    <audio src="@f.Url" controls preload="metadata" class="w-full" aria-label="@f.Name"></audio>
                                }
                                <div class="flex items-center gap-3">
                                    <span class="grid min-w-0 flex-1">
                                        <span class="truncate font-strong">@Kind(f)</span>
                                        <span class="text-small @(f.State == "failed" ? "font-strong text-status-danger-fg" : "text-text-muted")">@Progress(f)</span>
                                    </span>
                                    <button type="button" class="btn-secondary min-h-[48px] px-4" @onclick="() => Outbox.RemoveAsync(update.Id, f.Key)">Remove<span class="sr-only"> @f.Name</span></button>
                                </div>
                                @if (f.State is "waiting" or "uploading")
                                {
                                    <div class="h-[6px] overflow-hidden rounded-pill bg-surface-sunken" aria-hidden="true"><div class="h-full bg-action-primary-bg" style="width:@(f.Percent)%"></div></div>
                                }
                            </li>
                        }
                    </ul>
                }

                <button type="button" class="min-h-[48px] justify-self-start underline underline-offset-4" aria-expanded="@(_more ? "true" : "false")" @onclick="() => _more = !_more">@(_more ? "Fewer options" : "More options")@(_more || !Changed ? null : $" ({OptionWords})")</button>
                @if (_more)
                {
                    <section class="grid gap-4 rounded-card bg-surface-sunken p-4" aria-label="More options">
                        <div class="field">
                            <label class="field-label" for="who">Who it's for</label>
                            <select id="who" class="input min-h-[48px]" @bind="_o.Scope" @bind:after="SaveAsync">
                                <option value="Owners">All the owners</option>
                                <option value="NamedParties">Only some owners</option>
                                <option value="Internal">Staff only</option>
                            </select>
                        </div>
                        @if (_o.Scope == "NamedParties")
                        {
                            <fieldset class="grid gap-1">
                                <legend class="field-label mb-1">Which owners</legend>
                                @foreach (var owner in options.Owners)
                                {
                                    <label class="inline-flex min-h-[44px] items-center gap-3"><input type="checkbox" class="size-[22px] accent-action-primary-bg" checked="@_o.Named.Contains(owner.Id)" @onchange="() => ToggleAsync(owner.Id)" /> @owner.Name</label>
                                }
                            </fieldset>
                        }
                        @if (Event is { Steps.Count: > 0 } about)
                        {
                            <div class="field">
                                <label class="field-label" for="step">Step it ticks off</label>
                                <select id="step" class="input min-h-[48px]" value="@_o.Step" @onchange="ChooseStep">
                                    <option value="">None</option>
                                    @foreach (var step in about.Steps)
                                    {
                                        <option value="@step">@step</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (_o.Scope != "Internal")
                        {
                            <div class="field">
                                <label class="field-label" for="by">Send by</label>
                                <select id="by" class="input min-h-[48px]" @bind="_o.Channel" @bind:after="SaveAsync">
                                    <option value="Preferred">Each person's preference</option>
                                    <option value="Email">Email</option>
                                    <option value="Sms">Text message</option>
                                    <option value="PortalOnly">Their page only, no notification</option>
                                </select>
                            </div>
                            <label class="inline-flex min-h-[44px] items-center gap-3"><input type="checkbox" class="size-[22px] accent-action-primary-bg" @bind="_o.Asking" @bind:after="SaveAsync" /> Ask a question</label>
                            @if (_o.Asking)
                            {
                                <div class="field">
                                    <label class="field-label" for="kind">They answer with</label>
                                    <select id="kind" class="input min-h-[48px]" @bind="_o.Kind" @bind:after="SaveAsync">
                                        <option value="Count">A number</option>
                                        <option value="YesNo">Yes or no</option>
                                        <option value="Choice">A choice</option>
                                    </select>
                                </div>
                                <div class="field">
                                    <label class="field-label" for="question">Question</label>
                                    <input id="question" class="input min-h-[48px]" @bind="_o.Question" @bind:after="SaveAsync" />
                                </div>
                                @if (_o.Kind == "Count")
                                {
                                    <div class="field">
                                        <label class="field-label" for="most">Most anyone can ask for</label>
                                        <input id="most" type="number" inputmode="numeric" min="1" max="20" class="input min-h-[48px]" @bind="_o.Max" @bind:after="SaveAsync" />
                                    </div>
                                }
                                else if (_o.Kind == "Choice")
                                {
                                    <div class="field">
                                        <label class="field-label" for="choices">Choices, one per line</label>
                                        <textarea id="choices" class="input min-h-[96px] py-3" @bind="_o.Choices" @bind:after="SaveAsync"></textarea>
                                    </div>
                                }
                            }
                        }
                    </section>
                }
                @if (update.HasContent)
                {
                    <button type="button" class="min-h-[48px] justify-self-start text-small underline underline-offset-4" @onclick="DiscardAsync">@(_discarding ? "Sure? Press again to throw it away" : "Throw this update away")</button>
                }
            </main>

            <footer class="sticky bottom-0 grid gap-2 border-t border-border-subtle bg-surface-raised p-4">
                @if (_error is not null)
                {
                    <p class="alert-danger" role="alert">@_error</p>
                }
                else if (!Outbox.State.Online)
                {
                    <p class="text-small text-status-warning-fg" role="status">No signal. What you add is kept on this phone.</p>
                }
                <button type="button" class="btn-primary min-h-[56px] w-full text-body" disabled="@_busy" @onclick="SendAsync">@(_busy ? "One moment…" : SendLabel)</button>
            </footer>
        </div>
    }

    @if (_who is { } who && _options is { } sheet && Update is { } going)
    {
        <div class="fixed inset-0 z-50 flex items-end justify-center bg-[rgb(0_0_0/0.45)]" @onkeydown="SheetKey">
            <div @ref="_sheet" tabindex="-1" role="alertdialog" aria-modal="true" aria-labelledby="sheet-title"
                 class="grid max-h-[85vh] w-full max-w-2xl grid-rows-[auto_minmax(0,1fr)_auto] gap-4 rounded-card bg-surface-raised p-4 shadow-overlay outline-none">
                <h2 id="sheet-title" class="text-title">@(who.Going.Count == 0 ? "Nobody will be sent this" : $"Send to {Owners(who.Going.Count)} of {sheet.Horse}?")</h2>
                <div class="grid content-start gap-3 overflow-y-auto">
                    <p class="text-text-muted">@Contents(going)</p>
                    @if (who.Going.Count > 0)
                    {
                        <details class="rounded-control bg-surface-sunken px-4 py-3">
                            <summary class="cursor-pointer font-strong">@HowWords(who)</summary>
                            <ul class="mt-2 grid gap-1">
                                @foreach (var g in who.Going)
                                {
                                    <li class="flex justify-between gap-3"><span>@g.Name</span><span class="text-small text-text-muted">@g.How</span></li>
                                }
                            </ul>
                        </details>
                    }
                    else
                    {
                        <p>It will still show on the owners' pages for them to find.</p>
                    }
                    @if (who.LeftOut.Count > 0)
                    {
                        <div class="rounded-control bg-status-warning-bg px-4 py-3 text-status-warning-fg">
                            <p class="font-strong">Won't reach @Owners(who.LeftOut.Count)</p>
                            <ul class="mt-1 grid gap-1 text-small">
                                @foreach (var l in who.LeftOut)
                                {
                                    <li>@l.Name: @l.Why.ToLowerInvariant()</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
                <div class="grid gap-3">
                    <button type="button" class="btn-primary min-h-[56px] w-full" @onclick="ConfirmAsync">@(who.Going.Count == 0 ? "Add it without sending" : "Send now")</button>
                    <button type="button" class="btn-secondary min-h-[52px] w-full" @onclick="() => _who = null">Not yet</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const string Tile = "btn-secondary flex min-h-[80px] cursor-pointer flex-col items-center justify-center gap-1 px-1 text-small";

    /// <summary>What More options holds: kept with the update on the phone.</summary>
    private sealed class Options
    {
        public string Scope { get; set; } = "Owners";
        public List<Guid> Named { get; set; } = [];
        public string Step { get; set; } = "";
        public string Channel { get; set; } = "Preferred";
        public bool Asking { get; set; }
        public string Kind { get; set; } = "Count";
        public string Question { get; set; } = "";
        public int Max { get; set; } = 10;
        public string Choices { get; set; } = "";
    }

    [Parameter] public Guid Id { get; set; }

    /// <summary>Opened from an event: that one's chosen, and Back goes to it.</summary>
    [SupplyParameterFromQuery(Name = "event")] public Guid? EventFromQuery { get; set; }

    private UpdateChoices? _options;
    private string? _id, _error, _voiceProblem;
    private Guid? _event;
    private string _body = "";
    private Options _o = new();
    private bool _busy, _more, _recording, _paused, _fixing, _discarding, _bind;
    private RecipientsView? _who;
    private ElementReference _canvas, _clock, _video, _photo, _choose, _sheet;
    private bool _focusSheet, _bound;
    private CancellationTokenSource? _saving;

    private OutboxUpdate? Update => _id is null ? null : Outbox.Find(_id);

    private UpdateChoice? Event => _options?.Events.FirstOrDefault(e => e.Id == _event);

    private string EventKey => _event?.ToString() ?? "";

    private bool Changed => _o.Scope != "Owners" || _o.Step.Length > 0 || _o.Channel != "Preferred" || _o.Asking;

    private string OptionWords => string.Join(", ", new[]
    {
        _o.Scope switch { "Internal" => "staff only", "NamedParties" => Owners(_o.Named.Count), _ => null },
        _o.Step.Length > 0 ? _o.Step : null,
        _o.Asking ? "a question" : null,
    }.Where(w => w is not null));

    private string SendLabel => _o.Scope switch
    {
        "Internal" => "Save for staff",
        "NamedParties" => $"Send to {Owners(_o.Named.Count)}",
        _ => $"Send to {Owners(_options!.Owners.Count)}",
    };

    private static string Owners(int n) => n == 1 ? "1 owner" : $"{n} owners";

    private static string Kind(OutboxFile f) => f.Kind switch { "Audio" => f.Seconds is { } s ? $"Voice note, {s / 60}:{s % 60:00}" : f.Name, "Video" => $"Video, {Size(f.Size)}", _ => $"Photo, {Size(f.Size)}" };

    private static string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024:0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    private string Progress(OutboxFile f) => f.State switch
    {
        "done" => "Ready",
        "failed" => f.Error ?? "It didn't go up.",
        _ when Outbox.State.NeedsSignIn => "Sign in again to finish sending it",
        _ when !Outbox.State.Online => "Waiting for signal",
        "uploading" => $"Going up, {f.Percent}%. Keep writing.",
        _ => "Next to go up",
    };

    private static string Contents(OutboxUpdate u)
    {
        var parts = u.Files.GroupBy(f => f.Kind).Select(g => (g.Key, g.Count()) switch
        {
            ("Audio", 1) => "a voice note", ("Audio", var n) => $"{n} voice notes",
            ("Video", 1) => "a video", ("Video", var n) => $"{n} videos",
            (_, 1) => "a photo", (_, var n) => $"{n} photos",
        }).ToList();
        if (!string.IsNullOrWhiteSpace(u.Body)) parts.Insert(0, "your message");
        var words = parts.Count switch { 0 => "a question", 1 => parts[0], _ => string.Join(", ", parts.Take(parts.Count - 1)) + " and " + parts[^1] };
        return char.ToUpperInvariant(words[0]) + words[1..] + ".";
    }

    private static string HowWords(RecipientsView who) => string.Join(", ", who.Going.GroupBy(g => g.How).OrderByDescending(g => g.Count()).Select(g => $"{g.Count()} {(g.Key.StartsWith("On ") ? "on" : $"by {char.ToLowerInvariant(g.Key[0])}")}{g.Key[(g.Key.StartsWith("On ") ? 2 : 1)..]}"));

    private static RenderFragment Icon(string path) => __builder =>
    {
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="@path"></path></svg>
    };

    protected override async Task OnInitializedAsync()
    {
        Outbox.Changed += Refresh;
        Outbox.RecordingEnded += RecordingEnded;
        if (Session.Current is null && await Session.RefreshAsync() is null)
        {
            Navigation.NavigateTo("sign-in");
            return;
        }

        await Outbox.StartAsync();
        var result = await Api.UpdateChoicesAsync(Id);
        if (!result.Succeeded) { _error = result.Error; return; }
        _options = result.Value!;
        _id = Outbox.State.Updates.FirstOrDefault(u => u.HorseId == Id && u.State is "sending" or "failed")?.Id;
        await OpenAsync();
    }

    /// <summary>The update on its way for this horse, or the one being written, as it was left.</summary>
    private async Task OpenAsync()
    {
        _id ??= await Outbox.DraftAsync(Id, _options!.Horse);
        var update = Update;
        _body = update?.Body ?? "";
        try { _o = update?.Options is { } kept ? System.Text.Json.JsonSerializer.Deserialize<Options>(kept) ?? new() : new(); }
        catch (System.Text.Json.JsonException) { _o = new(); }
        var keptEvent = update is { HasContent: true } ? Guid.TryParse(update.EventId, out var e) ? e : (Guid?)null : EventFromQuery ?? _options!.Events[0].Id;
        _event = _options!.Events.Any(x => x.Id == keptEvent) ? keptEvent : _options.Events[0].Id;
        _bind = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The form only exists once there's a draft to write; its inputs are handed to the module when it does.
        var form = _options is { Managed: true } && Update is { } u && (u.State == "draft" || (u.State == "failed" && _fixing));
        if (form && (_bind || !_bound) && _id is not null)
        {
            (_bind, _bound) = (false, true);
            await Outbox.BindAsync(_video, _id);
            await Outbox.BindAsync(_photo, _id);
            await Outbox.BindAsync(_choose, _id);
        }
        else if (!form) _bound = false;

        if (_focusSheet) { _focusSheet = false; await _sheet.FocusAsync(); }
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private void RecordingEnded() => InvokeAsync(() =>
    {
        (_recording, _paused) = (false, false);
        _voiceProblem = "The phone stopped the recording. What you'd said is kept below.";
        StateHasChanged();
    });

    // ---- keeping it ------------------------------------------------------------------------------------------------

    private Task SaveAsync() => _id is null ? Task.CompletedTask : Outbox.SaveAsync(_id, _body, _event, _o);

    private async Task SaveSoon()
    {
        (_error, _discarding) = (null, false);
        _saving?.Cancel();
        var mine = _saving = new CancellationTokenSource();
        try { await Task.Delay(500, mine.Token); await SaveAsync(); }
        catch (TaskCanceledException) { }
    }

    private async Task ChooseEvent(ChangeEventArgs e)
    {
        _event = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _o.Step = "";
        await SaveAsync();
    }

    /// <summary>A step that suggests a question fills it in, unless one is already being written.</summary>
    private async Task ChooseStep(ChangeEventArgs e)
    {
        _o.Step = e.Value?.ToString() ?? "";
        if (Event?.StepPrompts.TryGetValue(_o.Step, out var suggested) == true && !(_o.Asking && _o.Question.Length > 0))
            (_o.Asking, _o.Kind, _o.Question, _o.Max, _o.Choices) = (true, suggested.Kind, suggested.Question, suggested.Max ?? 10, string.Join('\n', suggested.Options ?? []));
        await SaveAsync();
    }

    private async Task ToggleAsync(Guid owner)
    {
        if (!_o.Named.Remove(owner)) _o.Named.Add(owner);
        await SaveAsync();
    }

    private async Task DiscardAsync()
    {
        if (!_discarding) { _discarding = true; return; }
        _discarding = false;
        if (_id is not null) await Outbox.DiscardAsync(_id);
        (_id, _fixing, _error, _voiceProblem) = (null, false, null, null);
        await OpenAsync();
    }

    // ---- voice -----------------------------------------------------------------------------------------------------

    private async Task RecordAsync()
    {
        (_voiceProblem, _error) = (null, null);
        var problem = await Outbox.StartVoiceAsync(_id!, _canvas, _clock);
        if (problem is not null) { _voiceProblem = problem; return; }
        (_recording, _paused) = (true, false);
    }

    private async Task PauseAsync()
    {
        if (_paused) await Outbox.ResumeVoiceAsync();
        else await Outbox.PauseVoiceAsync();
        _paused = !_paused;
    }

    private async Task RestartAsync()
    {
        await Outbox.CancelVoiceAsync();
        _recording = false;
        await RecordAsync();
    }

    private async Task DoneAsync()
    {
        await Outbox.StopVoiceAsync();
        _recording = false;
    }

    // ---- sending ---------------------------------------------------------------------------------------------------

    private PromptRequest? Prompt => !_o.Asking || _o.Scope == "Internal" ? null
        : new(_o.Kind, _o.Question.Trim(), _o.Kind == "Choice" ? _o.Choices.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList() : null, _o.Kind == "Count" ? _o.Max : null);

    private async Task SendAsync()
    {
        var update = Update!;
        _error = update.Files.Any(f => f.State == "failed") ? "Take off the one that didn't go up, or add it again."
            : update.Files.Count == 0 && string.IsNullOrWhiteSpace(_body) && Prompt is null ? "Write something, or add a voice note, video or photo."
            : update.Files.Count > 0 && Prompt is not null ? "Send the question on its own, then the photos, video or voice note."
            : Prompt is { Question.Length: 0 } ? "Write the question, or untick Ask a question."
            : Prompt is { Kind: "Choice", Options.Count: < 2 } ? "Give at least two choices, one per line."
            : _o.Scope == "NamedParties" && _o.Named.Count == 0 ? "Choose at least one owner."
            : null;
        if (_error is not null) return;

        _busy = true;
        try
        {
            await SaveAsync();
            if (_o.Scope == "Internal") { await GoAsync(); return; }
            var result = await Api.UpdateRecipientsAsync(Id, _event, _o.Scope, _o.Step == "" ? null : _o.Step, _o.Channel, _o.Named, update.Files.Count > 0);
            if (!result.Succeeded) { _error = result.Error; return; }
            (_who, _focusSheet) = (result.Value, true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmAsync()
    {
        _who = null;
        await GoAsync();
    }

    private Task GoAsync()
    {
        _fixing = false;
        return Outbox.SendAsync(_id!, new UpdatePayload(_event, _o.Scope, _o.Step == "" ? null : _o.Step, _o.Channel, _o.Scope == "NamedParties" ? _o.Named : [], _body.Trim(), Prompt));
    }

    private void SheetKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _who = null;
    }

    private async Task EditAsync()
    {
        if (await Outbox.EditAsync(_id!)) await OpenAsync();
    }

    private async Task ViewAsync()
    {
        var to = Update?.SentEventId;
        await Outbox.SeenAsync(_id!);
        Navigation.NavigateTo(to is { } e ? $"events/{e}" : $"horses/{Id}");
    }

    private async Task AnotherAsync()
    {
        if (_id is not null) await Outbox.SeenAsync(_id);
        Navigation.NavigateTo("horses");
    }

    private async Task BackAsync()
    {
        if (_recording) { await Outbox.CancelVoiceAsync(); _recording = false; return; }
        await SaveAsync();
        if (_id is not null) await Outbox.SeenAsync(_id);
        Navigation.NavigateTo(EventFromQuery is { } e ? $"events/{e}" : $"horses/{Id}");
    }

    public async ValueTask DisposeAsync()
    {
        Outbox.Changed -= Refresh;
        Outbox.RecordingEnded -= RecordingEnded;
        _saving?.Cancel();
        if (_recording) await Outbox.CancelVoiceAsync();
    }
}
