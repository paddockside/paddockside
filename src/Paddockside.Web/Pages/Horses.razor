@page "/horses"
@inject PaddocksideApi Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Horses · Paddockside</PageTitle>

<div class="grid gap-4">
    <h1>Horses</h1>

    @if (_error is not null)
    {
        <Error Message="@_error" />
    }
    else if (_horses is null)
    {
        <p class="text-text-muted" role="status">Loading horses…</p>
    }
    else if (_horses.Count == 0)
    {
        <div class="card">
            <p>No horses yet. Horses you add or import will appear here.</p>
        </div>
    }
    else
    {
        <div class="card">
            @* On a phone each row becomes a stacked block, with the column name before each value. *@
            <table class="w-full border-collapse tabular-nums">
                <caption class="sr-only">The horses @Session.Current?.TenantName manages or has managed</caption>
                <thead class="hidden sm:table-header-group">
                    <tr class="border-b border-border-subtle text-left text-small font-strong text-text-muted">
                        <th scope="col" class="px-4 py-3">Name</th>
                        <th scope="col" class="px-4 py-3">Status</th>
                        <th scope="col" class="px-4 py-3">Managed since</th>
                        <th scope="col" class="px-4 py-3">Current owners</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var horse in _horses)
                    {
                        <tr class="grid gap-1 border-b border-border-subtle py-3 last:border-b-0 sm:table-row sm:py-0">
                            <td class="px-2 font-strong sm:px-4 sm:py-3"><a href="horses/@horse.Id" class="underline underline-offset-4 hover:text-action-primary-bg">@horse.Name</a></td>
                            <td class="px-2 sm:px-4 sm:py-3">
                                <span class="text-text-muted sm:hidden">Status: </span>
                                @if (horse.Managed)
                                {
                                    <span class="badge bg-status-success-bg text-status-success-fg">Managed</span>
                                }
                                else
                                {
                                    <span class="badge bg-action-secondary-bg text-text-muted">No longer managed</span>
                                }
                            </td>
                            <td class="px-2 sm:px-4 sm:py-3">
                                <span class="text-text-muted sm:hidden">Managed since: </span>@(horse.ManagedSince?.ToString("d MMMM yyyy") ?? "—")
                            </td>
                            <td class="px-2 sm:px-4 sm:py-3">
                                <span class="text-text-muted sm:hidden">Current owners: </span>@horse.CurrentOwners
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-text-muted">@_horses.Count(h => h.Managed) managed now, @_horses.Count in all.</p>
    }
</div>

@code {
    private List<HorseSummary>? _horses;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (await Session.RefreshAsync() is null)
        {
            Navigation.NavigateTo("sign-in");
            return;
        }

        var result = await Api.HorsesAsync();
        if (result.Succeeded) _horses = result.Value;
        else _error = result.Error;
    }
}
