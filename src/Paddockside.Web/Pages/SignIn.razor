@page "/sign-in"
@inject PaddocksideApi Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Sign in · Paddockside</PageTitle>

<div class="card mx-auto grid max-w-md gap-4">
    @switch (_step)
    {
        case Step.Password:
            <h1>Staff sign in</h1>
            <p class="text-text-muted">Owners do not need to sign in here. Use the link in any message we send you.</p>
            <EditForm Model="_form" OnValidSubmit="SubmitPassword" FormName="password" class="grid gap-4">
                <div class="field">
                    <label class="field-label" for="email">Email</label>
                    <InputText id="email" class="input" type="email" autocomplete="username" @bind-Value="_form.Email" required />
                </div>
                <div class="field">
                    <label class="field-label" for="password">Password</label>
                    <InputText id="password" class="input" type="password" autocomplete="current-password" @bind-Value="_form.Password" required />
                </div>
                <Error Message="@_error" />
                <button type="submit" class="btn-primary w-full" disabled="@_busy">Continue</button>
            </EditForm>
            break;

        case Step.AuthenticatorCode:
            <h1>Enter your code</h1>
            <p>Open your authenticator app and type the 6-digit code shown for Paddockside.</p>
            <EditForm Model="_form" OnValidSubmit="SubmitCode" FormName="totp" class="grid gap-4">
                <div class="field">
                    <label class="field-label" for="code">6-digit code</label>
                    <InputText id="code" class="input-code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" @bind-Value="_form.Code" required />
                </div>
                <Error Message="@_error" />
                <button type="submit" class="btn-primary w-full" disabled="@_busy">Sign in</button>
            </EditForm>
            <button type="button" class="btn-link" @onclick="() => Go(Step.RecoveryCode)">I can't use my authenticator app</button>
            break;

        case Step.RecoveryCode:
            <h1>Use a recovery code</h1>
            <p>Type one of the recovery codes you saved when you set up your authenticator. Each code works once.</p>
            <EditForm Model="_form" OnValidSubmit="SubmitRecoveryCode" FormName="recovery" class="grid gap-4">
                <div class="field">
                    <label class="field-label" for="recovery">Recovery code</label>
                    <InputText id="recovery" class="input-code" autocomplete="off" @bind-Value="_form.Code" required />
                </div>
                <Error Message="@_error" />
                <button type="submit" class="btn-primary w-full" disabled="@_busy">Sign in</button>
            </EditForm>
            <button type="button" class="btn-link" @onclick="() => Go(Step.AuthenticatorCode)">Use my authenticator app instead</button>
            <p class="text-text-muted">No codes left? Ask your tenant admin to reset your second step.</p>
            break;

        case Step.Enrol:
            <h1>Set up your authenticator</h1>
            <p>Staff accounts need a second step when signing in. You only do this once on each account.</p>
            @if (_enrolment is null)
            {
                <Error Message="@_error" />
                <p class="text-text-muted" role="status">Preparing…</p>
            }
            else
            {
                <ol class="grid list-decimal gap-4 pl-6 marker:font-heading">
                    <li>Install an authenticator app on your phone, such as Microsoft Authenticator or Google Authenticator.</li>
                    <li>In the app, choose to add an account, then scan this code.
                        <img class="my-3 block size-[12rem] rounded-control bg-surface-qr p-2 [image-rendering:pixelated]" src="data:image/png;base64,@_enrolment.QrCodePng" alt="QR code for adding Paddockside to your authenticator app" />
                        <span class="field-hint block">Can't scan it? Choose "enter a key" in the app and type: <strong class="break-all tracking-wide tabular-nums">@_enrolment.SharedKey</strong></span>
                    </li>
                    <li>Type the 6-digit code the app now shows.</li>
                </ol>
                <EditForm Model="_form" OnValidSubmit="SubmitEnrolment" FormName="enrol" class="grid gap-4">
                    <div class="field">
                        <label class="field-label" for="enrol-code">6-digit code</label>
                        <InputText id="enrol-code" class="input-code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" @bind-Value="_form.Code" required />
                    </div>
                    <Error Message="@_error" />
                    <button type="submit" class="btn-primary w-full" disabled="@_busy">Finish setting up</button>
                </EditForm>
            }
            break;

        case Step.SaveRecoveryCodes:
            <h1>Save your recovery codes</h1>
            <p>If you lose your phone, each of these codes lets you sign in once. Print them or keep them somewhere safe. You will not see them again.</p>
            <ul class="grid list-none grid-cols-2 gap-x-6 gap-y-2 rounded-control bg-surface-sunken p-4 text-title tabular-nums">
                @foreach (var recoveryCode in _recoveryCodes)
                {
                    <li>@recoveryCode</li>
                }
            </ul>
            <button type="button" class="btn-primary w-full" @onclick="Finish">I have saved them, continue</button>
            break;
    }
</div>

@code {
    private enum Step { Password, AuthenticatorCode, RecoveryCode, Enrol, SaveRecoveryCodes }

    private sealed class Form
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string Code { get; set; } = "";
    }

    private readonly Form _form = new();
    private Step _step = Step.Password;
    private EnrolmentDetails? _enrolment;
    private IReadOnlyList<string> _recoveryCodes = [];
    private string? _error;
    private bool _busy;

    /// <summary>Set by an accepted invitation (/join): the password step is done; go straight to the second factor.</summary>
    [SupplyParameterFromQuery(Name = "continue")] public string? Continue { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Continue == "totp")
        {
            Go(Step.AuthenticatorCode);
        }
        else if (Continue == "enrol")
        {
            Go(Step.Enrol);
            var enrolment = await Api.StartEnrolmentAsync();
            if (enrolment.Succeeded) _enrolment = enrolment.Value;
            else (_step, _error) = (Step.Password, "Your invitation was accepted, but setting up the authenticator did not start. Sign in with your new password to continue.");
        }
    }

    private void Go(Step step)
    {
        _step = step;
        _error = null;
        _form.Code = "";
    }

    private Task SubmitPassword() => Run(async () =>
    {
        var result = await Api.SubmitPasswordAsync(_form.Email, _form.Password);
        _form.Password = "";
        if (!result.Succeeded) { _error = result.Error; return; }

        if (result.Value!.Next == "enrol")
        {
            Go(Step.Enrol);
            var enrolment = await Api.StartEnrolmentAsync();
            if (enrolment.Succeeded) _enrolment = enrolment.Value;
            else _error = enrolment.Error;
        }
        else
        {
            Go(Step.AuthenticatorCode);
        }
    });

    private Task SubmitCode() => Run(async () =>
    {
        var result = await Api.SubmitAuthenticatorCodeAsync(_form.Code);
        if (result.Succeeded) await Finish();
        else _error = result.Error;
    });

    private Task SubmitRecoveryCode() => Run(async () =>
    {
        var result = await Api.SubmitRecoveryCodeAsync(_form.Code);
        if (result.Succeeded) await Finish();
        else _error = result.Error;
    });

    private Task SubmitEnrolment() => Run(async () =>
    {
        var result = await Api.CompleteEnrolmentAsync(_form.Code);
        if (!result.Succeeded) { _error = result.Error; return; }
        _recoveryCodes = result.Value!.Codes;
        Go(Step.SaveRecoveryCodes);
    });

    /// <summary>Staff go to their horses; an operator with no business membership goes to the operator console.</summary>
    private async Task Finish()
    {
        Navigation.NavigateTo(await Session.RefreshAsync() is null ? "ops" : "horses");
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try { await action(); }
        finally { _busy = false; }
    }
}
