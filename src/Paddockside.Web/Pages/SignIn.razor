@page "/sign-in"
@inject PaddocksideApi Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>Sign in · Paddockside</PageTitle>

<div class="sign-in ps-card">
    @switch (_step)
    {
        case Step.Password:
            <h1>Staff sign in</h1>
            <p class="ps-muted">Owners do not need to sign in here. Use the link in any message we send you.</p>
            <EditForm Model="_form" OnValidSubmit="SubmitPassword" FormName="password" class="ps-stack">
                <div class="ps-field">
                    <label class="ps-field__label" for="email">Email</label>
                    <InputText id="email" class="ps-input" type="email" autocomplete="username" @bind-Value="_form.Email" required />
                </div>
                <div class="ps-field">
                    <label class="ps-field__label" for="password">Password</label>
                    <InputText id="password" class="ps-input" type="password" autocomplete="current-password" @bind-Value="_form.Password" required />
                </div>
                <Error Message="@_error" />
                <button type="submit" class="ps-button ps-button--primary ps-button--full" disabled="@_busy">Continue</button>
            </EditForm>
            break;

        case Step.AuthenticatorCode:
            <h1>Enter your code</h1>
            <p>Open your authenticator app and type the 6-digit code shown for Paddockside.</p>
            <EditForm Model="_form" OnValidSubmit="SubmitCode" FormName="totp" class="ps-stack">
                <div class="ps-field">
                    <label class="ps-field__label" for="code">6-digit code</label>
                    <InputText id="code" class="ps-input ps-input--code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" @bind-Value="_form.Code" required />
                </div>
                <Error Message="@_error" />
                <button type="submit" class="ps-button ps-button--primary ps-button--full" disabled="@_busy">Sign in</button>
            </EditForm>
            <button type="button" class="ps-button ps-button--link" @onclick="() => Go(Step.RecoveryCode)">I can't use my authenticator app</button>
            break;

        case Step.RecoveryCode:
            <h1>Use a recovery code</h1>
            <p>Type one of the recovery codes you saved when you set up your authenticator. Each code works once.</p>
            <EditForm Model="_form" OnValidSubmit="SubmitRecoveryCode" FormName="recovery" class="ps-stack">
                <div class="ps-field">
                    <label class="ps-field__label" for="recovery">Recovery code</label>
                    <InputText id="recovery" class="ps-input ps-input--code" autocomplete="off" @bind-Value="_form.Code" required />
                </div>
                <Error Message="@_error" />
                <button type="submit" class="ps-button ps-button--primary ps-button--full" disabled="@_busy">Sign in</button>
            </EditForm>
            <button type="button" class="ps-button ps-button--link" @onclick="() => Go(Step.AuthenticatorCode)">Use my authenticator app instead</button>
            <p class="ps-muted">No codes left? Ask your tenant admin to reset your second step.</p>
            break;

        case Step.Enrol:
            <h1>Set up your authenticator</h1>
            <p>Staff accounts need a second step when signing in. You only do this once on each account.</p>
            @if (_enrolment is null)
            {
                <Error Message="@_error" />
                <p class="ps-muted" role="status">Preparing…</p>
            }
            else
            {
                <ol class="sign-in__steps">
                    <li>Install an authenticator app on your phone, such as Microsoft Authenticator or Google Authenticator.</li>
                    <li>In the app, choose to add an account, then scan this code.
                        <img class="sign-in__qr" src="data:image/png;base64,@_enrolment.QrCodePng" alt="QR code for adding Paddockside to your authenticator app" />
                        <span class="ps-field__hint">Can't scan it? Choose "enter a key" in the app and type: <strong class="sign-in__key">@_enrolment.SharedKey</strong></span>
                    </li>
                    <li>Type the 6-digit code the app now shows.</li>
                </ol>
                <EditForm Model="_form" OnValidSubmit="SubmitEnrolment" FormName="enrol" class="ps-stack">
                    <div class="ps-field">
                        <label class="ps-field__label" for="enrol-code">6-digit code</label>
                        <InputText id="enrol-code" class="ps-input ps-input--code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" @bind-Value="_form.Code" required />
                    </div>
                    <Error Message="@_error" />
                    <button type="submit" class="ps-button ps-button--primary ps-button--full" disabled="@_busy">Finish setting up</button>
                </EditForm>
            }
            break;

        case Step.SaveRecoveryCodes:
            <h1>Save your recovery codes</h1>
            <p>If you lose your phone, each of these codes lets you sign in once. Print them or keep them somewhere safe. You will not see them again.</p>
            <ul class="sign-in__codes">
                @foreach (var recoveryCode in _recoveryCodes)
                {
                    <li>@recoveryCode</li>
                }
            </ul>
            <button type="button" class="ps-button ps-button--primary ps-button--full" @onclick="Finish">I have saved them, continue</button>
            break;
    }
</div>

@code {
    private enum Step { Password, AuthenticatorCode, RecoveryCode, Enrol, SaveRecoveryCodes }

    private sealed class Form
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string Code { get; set; } = "";
    }

    private readonly Form _form = new();
    private Step _step = Step.Password;
    private EnrolmentDetails? _enrolment;
    private IReadOnlyList<string> _recoveryCodes = [];
    private string? _error;
    private bool _busy;

    private void Go(Step step)
    {
        _step = step;
        _error = null;
        _form.Code = "";
    }

    private Task SubmitPassword() => Run(async () =>
    {
        var result = await Api.SubmitPasswordAsync(_form.Email, _form.Password);
        _form.Password = "";
        if (!result.Succeeded) { _error = result.Error; return; }

        if (result.Value!.Next == "enrol")
        {
            Go(Step.Enrol);
            var enrolment = await Api.StartEnrolmentAsync();
            if (enrolment.Succeeded) _enrolment = enrolment.Value;
            else _error = enrolment.Error;
        }
        else
        {
            Go(Step.AuthenticatorCode);
        }
    });

    private Task SubmitCode() => Run(async () =>
    {
        var result = await Api.SubmitAuthenticatorCodeAsync(_form.Code);
        if (result.Succeeded) await Finish();
        else _error = result.Error;
    });

    private Task SubmitRecoveryCode() => Run(async () =>
    {
        var result = await Api.SubmitRecoveryCodeAsync(_form.Code);
        if (result.Succeeded) await Finish();
        else _error = result.Error;
    });

    private Task SubmitEnrolment() => Run(async () =>
    {
        var result = await Api.CompleteEnrolmentAsync(_form.Code);
        if (!result.Succeeded) { _error = result.Error; return; }
        _recoveryCodes = result.Value!.Codes;
        Go(Step.SaveRecoveryCodes);
    });

    private async Task Finish()
    {
        await Session.RefreshAsync();
        Navigation.NavigateTo("horses");
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try { await action(); }
        finally { _busy = false; }
    }
}
