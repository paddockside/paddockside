@page "/events/{Id:guid}"
@inject PaddocksideApi Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@(_page?.Event.Title ?? "Event") · Paddockside</PageTitle>

@*
    The event page (search-reporting.md §3, event stream; event-page-mockup-notes.md "Timeline model"): the horse's
    events in a rail on the left, so the timeline is only ever one event deep; then this event and its step strip,
    every item newest first on one vertical spine (facts, messages with their replies and delivery line, staff-only
    notes), and the compose box at the bottom. Staff view.
*@
<div class="grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-start">
    @if (_page is not null && _events is { Count: > 1 })
    {
        @* Phones: the other events fold away above the timeline. Wide screens: a rail that stays in view. *@
        <details class="card lg:hidden">
            <summary class="cursor-pointer font-strong">All events for @_page.HorseName (@_events.Count)</summary>
            <div class="mt-3">@EventRail</div>
        </details>
        <nav class="sticky top-6 hidden lg:block" aria-label="Events for @_page.HorseName">@EventRail</nav>
    }
    else if (_page is not null)
    {
        <div class="hidden lg:block"></div>
    }
<div class="grid grid-cols-[minmax(0,1fr)] gap-6">
    @if (_error is not null && _page is null)
    {
        <a href="horses" class="btn-link justify-self-start">← All horses</a>
        <Error Message="@_error" />
    }
    else if (_page is null)
    {
        <p class="text-text-muted" role="status">Loading…</p>
    }
    else
    {
        <div class="flex flex-wrap items-center justify-between gap-4">
            <a href="horses/@_page.HorseId" class="btn-link">← @_page.HorseName</a>
            <a href="events/@Id#write" class="btn-secondary">Write an update</a>
        </div>

        <h1 class="sr-only">@_page.Event.Title</h1>
        <EventCard Model="_page.Event.ToCard()" />

        <section class="grid grid-cols-[minmax(0,1fr)] gap-4 border-l-2 border-border-subtle pl-4 sm:pl-6" aria-label="Updates, newest first">
            @if (_page.Items.Count == 0)
            {
                <div class="card"><p>Nothing posted yet. Facts, messages and notes for this event will appear here.</p></div>
            }
            @foreach (var item in _page.Items)
            {
                @switch (item.Kind)
                {
                    case "Fact":
                        <FactCard Model="item.ToFact()" />
                        break;
                    case "Note":
                        <article class="grid gap-2 rounded-card border border-dashed border-border-strong border-l-4 border-l-kind-note-fg bg-kind-note-bg p-4">
                            <header class="flex flex-wrap items-center gap-2">
                                <KindMark Kind="Kind.Note" />
                                <span class="text-small text-text-muted">@item.Author · @item.At@(item.Step is null ? null : $" · Step: {item.Step}")</span>
                                <span class="ml-auto"><ScopeMark Scope="Scope.Internal" /></span>
                            </header>
                            <p class="whitespace-pre-line">@item.Body</p>
                        </article>
                        break;
                    default:
                        <MessageThread Model="item.ToMessage()" />
                        break;
                }
            }
        </section>

        <section id="write" class="grid grid-cols-[minmax(0,1fr)] gap-3" aria-labelledby="write-heading">
            <h2 id="write-heading">Write an update</h2>
            @if (_saved is not null)
            {
                <p class="rounded-control bg-status-success-bg px-4 py-3 text-status-success-fg" role="status">@_saved</p>
            }
            @if (_error is not null)
            {
                <Error Message="@_error" />
            }
            <ComposeBox Steps="_page.StepOptions" NamedPartyChoices="Owners" Busy="_busy" OnSend="Send" />
        </section>
    }
</div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private EventPage? _page;
    private List<EventSummary>? _events;

    /// <summary>The horse's events, newest first, this one marked as the current page.</summary>
    private RenderFragment EventRail => @<ol class="grid gap-1">
        <li class="px-3 pb-2 text-small font-strong text-text-muted">@_page!.HorseName</li>
        @foreach (var e in _events!)
        {
            var current = e.Id == Id;
            <li>
                <a href="events/@e.Id" aria-current="@(current ? "page" : null)"
                   class="grid gap-0.5 rounded-control px-3 py-2 @(current ? "bg-action-secondary-bg font-strong" : "hover:bg-surface-sunken") @(e.Status is "Closed" or "Cancelled" ? "text-text-muted" : null)">
                    <span class="@(e.Status == "Cancelled" ? "line-through" : null)">@e.Title</span>
                    <span class="text-small text-text-muted">@e.Type · @e.KeyDate@(e.Status == "Open" ? null : $" · {e.Status}")</span>
                </a>
            </li>
        }
    </ol>;
    private string? _error;
    private string? _saved;
    private bool _busy;

    private IReadOnlyList<PartyOption> Owners => _page?.Owners.Select(o => new PartyOption(o.Id.ToString(), o.Name)).ToList() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        if (Session.Current is null && await Session.RefreshAsync() is null)
        {
            Navigation.NavigateTo("sign-in");
            return;
        }

        await Load();
    }

    private async Task Load()
    {
        var result = await Api.EventAsync(Id);
        if (!result.Succeeded) { _error = result.Error; return; }
        _page = result.Value;

        var events = await Api.HorseEventsAsync(_page!.HorseId);
        _events = events.Succeeded ? events.Value : null; // the rail is a convenience; the page works without it
    }

    private async Task Send(ComposeDraft draft)
    {
        _busy = true;
        _error = null;
        _saved = null;
        try
        {
            var request = new ComposeRequest(
                draft.Audience.ToString(),
                draft.Scope.ToString(),
                draft.Step,
                draft.Channel.ToString(),
                draft.NamedParties.Select(Guid.Parse).ToList(),
                draft.Body);
            var result = await Api.PostToEventAsync(Id, request);
            if (!result.Succeeded) { _error = result.Error; return; }

            _saved = draft.Audience switch
            {
                Audience.InternalNote => "Note added.",
                Audience.Trainer => "Saved. Messages to the trainer start sending once the trainer is recorded on the horse.",
                _ => $"Sending to {result.Value!.Recipients} {(result.Value.Recipients == 1 ? "owner" : "owners")} now. Each gets their own reply address; the delivery line updates as Postmark reports back.",
            };
            await Load();
            if (draft.Audience == Audience.Owners)
            {
                // The background sender picks it up within a few seconds; show the result without a manual refresh.
                await Task.Delay(TimeSpan.FromSeconds(6));
                await Load();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
