@inject PaddocksideApi Api

@*
    Changing one owner's share (ownership-model.md scenarios 1–3): pass all or part of it on — to themselves (keeping
    part) or other clients, looked up, never typed in — or record that they've left with nobody taking over. The percentages
    must add up to what they hold. Whoever stops owning is locked out of the horse in the portal, or keeps read-only
    sight of their own time. Or, when it was simply entered wrongly, correct it: nothing passes on and nobody is told.
    Managers and admins.
*@
<form class="card grid gap-4" @onsubmit="SaveAsync" @onsubmit:preventDefault aria-label="Change @Owner.Name's share">
    <h3 class="text-title">@Owner.Name's @Owner.Percent</h3>

    <fieldset class="grid gap-2">
        <legend class="field-label mb-1">What's happening</legend>
        <label class="inline-flex items-center gap-2"><input type="radio" name="@_id-mode" class="size-[18px] accent-action-primary-bg" checked="@(_mode == Mode.Pass)" @onchange="() => _mode = Mode.Pass" /> All or part of the share is passed on</label>
        @if (!Owner.IsHouse)
        {
            <label class="inline-flex items-center gap-2"><input type="radio" name="@_id-mode" class="size-[18px] accent-action-primary-bg" checked="@(_mode == Mode.Leave)" @onchange="() => _mode = Mode.Leave" /> They're leaving, and nobody is taking over</label>
        }
        <label class="inline-flex items-center gap-2"><input type="radio" name="@_id-mode" class="size-[18px] accent-action-primary-bg" checked="@(_mode == Mode.Correct)" @onchange="() => _mode = Mode.Correct" /> It was entered wrongly: correct it</label>
    </fieldset>

    @if (_mode == Mode.Correct)
    {
        <div class="field w-[12rem]">
            <label class="field-label" for="@_id-correct">Their share is actually (%)</label>
            <input id="@_id-correct" class="input" type="number" min="0.1" max="100" step="0.1" @bind="_corrected" />
        </div>
        <p class="field-hint">As if it had always been this: nothing is passed on, nobody is told, and the horse's history shows no change. The audit log records the correction and who made it.</p>
    }
    else if (_mode == Mode.Pass)
    {
        <fieldset class="grid gap-3">
            <legend class="field-label mb-1">Who has it now</legend>
            @foreach (var (row, n) in _rows.Select((r, n) => (r, n)))
            {
                <div class="grid gap-2 rounded-control border border-border-subtle p-3">
                    <div class="flex flex-wrap items-start gap-3">
                        <div class="min-w-0 flex-1 basis-[14rem]">
                            @if (row.Keeps)
                            {
                                <div class="field">
                                    <span class="field-label">@Owner.Name</span>
                                    <span class="inline-flex min-h-control items-center">Keeps this part</span>
                                </div>
                            }
                            else
                            {
                                <ClientPicker @key="row" Label="Client" Chosen="row.Client" ChosenChanged="c => row.Client = c" Exclude="Taken(row)" />
                            }
                        </div>
                        <div class="field w-[8rem]">
                            <label class="field-label" for="@_id-pct-@n">Share (%)</label>
                            <input id="@_id-pct-@n" class="input" type="number" min="0.1" max="100" step="0.1" @bind="row.Percent" @bind:after="StateHasChanged" />
                        </div>
                        @if (_rows.Count > 1)
                        {
                            <button type="button" class="min-h-control self-center text-small underline underline-offset-4" @onclick="() => _rows.Remove(row)">Remove</button>
                        }
                    </div>
                </div>
            }
            <div class="flex flex-wrap items-center gap-4">
                <button type="button" class="text-small font-strong underline underline-offset-4" @onclick="() => _rows.Add(new Row())">Add another client</button>
                @if (!_rows.Any(r => r.Keeps))
                {
                    <button type="button" class="text-small font-strong underline underline-offset-4" @onclick="() => _rows.Insert(0, new Row { Keeps = true })">@Owner.Name keeps part</button>
                }
                <span class="text-small @(Total == Held ? "text-action-primary-bg" : "text-status-warning-fg")" role="status">
                    @Total.ToString("0.#")% of their @Owner.Percent passed on@(Total == Held ? "" : $": {Math.Abs(Held - Total):0.#}% {(Total < Held ? "still to place" : "too much")}")
                </span>
            </div>
            <p class="field-hint">With their first share, a client is sent their invitation to the owners' portal.</p>
        </fieldset>
    }
    else if (HasHouse)
    {
        <label class="inline-flex items-center gap-2">
            <input type="checkbox" class="size-[18px] accent-action-primary-bg" checked="@_toHouse" @onchange="e => _toHouse = e.Value is true" />
            Their share goes back to the house share (otherwise it's left unallocated)
        </label>
    }

    @if (_mode != Mode.Correct)
    {
    <div class="grid gap-4 sm:grid-cols-2">
        <div class="field">
            <label class="field-label" for="@_id-on">On</label>
            <input id="@_id-on" class="input" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" @bind="_on" />
        </div>
        @if (Leaves)
        {
            <fieldset class="grid gap-2">
                <legend class="field-label mb-1">Afterwards, @Owner.Name</legend>
                <label class="inline-flex items-center gap-2"><input type="radio" name="@_id-access" class="size-[18px] accent-action-primary-bg" checked="@(!_readOnly)" @onchange="() => _readOnly = false" /> No longer sees the horse</label>
                <label class="inline-flex items-center gap-2"><input type="radio" name="@_id-access" class="size-[18px] accent-action-primary-bg" checked="@_readOnly" @onchange="() => _readOnly = true" /> Can still read what happened while they owned it</label>
            </fieldset>
        }
    </div>
    }

    @if (_error is not null)
    {
        <p class="alert-danger" role="alert">@_error</p>
    }
    <div class="flex flex-wrap gap-3">
        <button type="submit" class="btn-primary" disabled="@(_busy || (_mode == Mode.Pass && (Total != Held || Incomplete)) || (_mode == Mode.Correct && (_corrected ?? 0) <= 0))">@SubmitLabel</button>
        <button type="button" class="btn-secondary" @onclick="OnCancel">Cancel</button>
    </div>
</form>

@code {
    private readonly string _id = $"own-{Guid.NewGuid():N}";
    private readonly List<Row> _rows = [];
    private enum Mode { Pass, Leave, Correct }

    private Mode _mode = Mode.Pass;
    private decimal? _corrected;
    private bool _toHouse = true, _readOnly, _busy;
    private DateTime _on = DateTime.Today;
    private string? _error;

    [Parameter, EditorRequired] public Guid HorseId { get; set; }

    [Parameter, EditorRequired] public OwnerLine Owner { get; set; } = null!;

    /// <summary>The business holds a house share, so a leaver's share can go back to it.</summary>
    [Parameter] public bool HasHouse { get; set; }

    [Parameter] public EventCallback<string> OnDone { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }

    private sealed class Row
    {
        /// <summary>The owner themselves, keeping this part.</summary>
        public bool Keeps { get; init; }
        public ClientRow? Client { get; set; }
        public decimal? Percent { get; set; }
    }

    private decimal Held => decimal.Parse(Owner.Percent.TrimEnd('%'), System.Globalization.CultureInfo.InvariantCulture);

    private decimal Total => _rows.Sum(r => r.Percent ?? 0);

    /// <summary>They stop owning: they leave, or none of the share stays with them.</summary>
    private bool Leaves => _mode == Mode.Leave || _rows.All(r => !r.Keeps || (r.Percent ?? 0) == 0);

    /// <summary>Not offered in this row: the owner, and anyone already chosen in another.</summary>
    private HashSet<Guid> Taken(Row row) => [Owner.PartyId, .. _rows.Where(r => r != row && r.Client is not null).Select(r => r.Client!.Id)];

    private bool Incomplete => _rows.Any(r => !r.Keeps && r.Client is null);

    private string SubmitLabel => _mode switch
    {
        Mode.Leave => "Record that they've left",
        Mode.Correct => "Correct the share",
        _ => "Pass the share on",
    };

    protected override void OnInitialized()
    {
        _rows.Add(new Row { Percent = Held });
        _corrected = Held;
    }

    private async Task SaveAsync()
    {
        (_error, _busy) = (null, true);
        try
        {
            var on = _on.ToString("yyyy-MM-dd");
            var access = Leaves && _readOnly ? "ReadOnly" : "LockedOut";
            ApiResult<object> result;
            if (_mode == Mode.Correct)
            {
                result = await Api.CorrectShareAsync(HorseId, Owner.PartyId, _corrected ?? 0);
                if (!result.Succeeded) { _error = result.Error; return; }
                await OnDone.InvokeAsync($"{Owner.Name}'s share is corrected to {_corrected:0.#}%. Nobody was told.");
                return;
            }

            if (_mode == Mode.Leave)
            {
                result = await Api.OwnerLeavesAsync(HorseId, Owner.PartyId, HasHouse && _toHouse, on, access);
            }
            else
            {
                var recipients = _rows.Where(r => (r.Percent ?? 0) > 0)
                    .Select(r => new ShareRecipient(r.Keeps ? Owner.PartyId : r.Client!.Id, r.Percent!.Value)).ToList();
                result = await Api.TransferShareAsync(HorseId, Owner.PartyId, recipients, on, access);
            }

            if (!result.Succeeded) { _error = result.Error; return; }
            await OnDone.InvokeAsync(_mode == Mode.Leave
                ? $"{Owner.Name} has left{(HasHouse && _toHouse ? "; their share is back with the house" : "; their share is unallocated")}."
                : $"{Owner.Name}'s share has been passed on. Anyone with their first share is sent their portal invitation.");
        }
        finally
        {
            _busy = false;
        }
    }
}
