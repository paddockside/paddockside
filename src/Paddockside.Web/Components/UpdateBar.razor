@implements IDisposable
@inject BuildCheck Build

@* Pops in at the top when Paddockside has been updated since this tab was opened (David, 26 Nov 2026). *@
<div class="sticky top-0 z-40" role="status">
    @if (Build.Updated)
    {
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-border-subtle bg-status-info-bg px-4 py-1 text-small text-status-info-fg sm:px-6">
            <span class="min-w-0 flex-1 basis-[14rem] py-1"><span class="font-strong">Paddockside has been updated.</span> Refresh when you're ready.</span>
            <span class="flex items-center gap-4">
                <button type="button" class="min-h-control font-strong underline underline-offset-4" @onclick="Build.RefreshAsync">Refresh</button>
                <button type="button" class="min-h-control underline underline-offset-4" @onclick="Build.Later">Later</button>
            </span>
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Build.Changed += Redraw;
        await Build.StartAsync();
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => Build.Changed -= Redraw;
}
