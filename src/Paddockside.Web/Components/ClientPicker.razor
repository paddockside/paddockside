@inject PaddocksideApi Api

@*
    Choosing one client (David, 25 Nov 2026: adding an owner "should only be allowed look up from clients"): type a name,
    email or mobile and pick from the matches. What's typed is only ever a search, never saved. Once chosen, they show by
    name and email with Change. Someone who isn't a client yet is added in Clients, in a new tab so nothing here is lost;
    the list is read again each time the box is gone back to. Arrow keys move, Enter chooses, Escape closes.
*@
<div class="field">
    @if (Chosen is { } chosen)
    {
        <span class="field-label">@Label</span>
        <div class="flex min-h-control flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-control border border-border-strong bg-surface-sunken px-4 py-2">
            <span class="grid min-w-0">
                <span class="truncate font-strong">@chosen.Name</span>
                <span class="truncate text-small text-text-muted">@Line(chosen)</span>
            </span>
            <button type="button" class="text-small font-strong underline underline-offset-4" aria-label="Choose someone other than @chosen.Name" @onclick="ClearAsync">Change</button>
        </div>
    }
    else
    {
        <label class="field-label" for="@_inputId">@Label</label>
        <div class="relative">
            <input @ref="_input" id="@_inputId" class="input w-full" type="text" role="combobox" autocomplete="off" placeholder="Type a name, email or mobile"
                   aria-expanded="@(_open && Matches.Count > 0 ? "true" : "false")" aria-controls="@_listId" aria-autocomplete="list"
                   aria-activedescendant="@(_open && _active < Matches.Count ? OptionId(Matches[_active].Id) : null)"
                   value="@_query" @oninput="Typed" @onfocus="FocusedAsync" @onblur="CloseSoon" @onkeydown="KeyAsync" />
            @if (_open && Matches.Count > 0)
            {
                <ul id="@_listId" role="listbox" aria-label="Clients"
                    class="absolute inset-x-0 top-full z-10 mt-1 grid max-h-[16rem] overflow-y-auto rounded-control border border-border-strong bg-surface-raised py-1 shadow-overlay">
                    @for (var i = 0; i < Matches.Count; i++)
                    {
                        var client = Matches[i];
                        var index = i;
                        <li id="@OptionId(client.Id)" role="option" aria-selected="@(index == _active ? "true" : "false")"
                            class="grid cursor-pointer px-4 py-2 @(index == _active ? "bg-surface-sunken" : null)"
                            @onmousedown="() => ChooseAsync(client)" @onmousedown:preventDefault @onmouseover="() => _active = index">
                            <span>@client.Name</span>
                            <span class="truncate text-small text-text-muted">@Line(client)</span>
                        </li>
                    }
                </ul>
            }
        </div>
        @if (_error is not null)
        {
            <span class="text-small text-status-danger-fg" role="alert">@_error</span>
        }
        else if (_open && Query.Length > 0 && Matches.Count == 0)
        {
            <span class="text-small text-text-muted" role="status">@NoMatch</span>
        }
        <span class="field-hint">Not a client yet? <a href="clients?add=true" target="_blank" class="font-strong underline underline-offset-4">Add them in Clients</a> (opens a new tab), then find them here.</span>
    }
</div>

@code {
    private readonly string _inputId = $"client-{Guid.NewGuid():N}";
    private readonly string _listId = $"client-{Guid.NewGuid():N}-options";
    private ElementReference _input;
    private List<ClientRow>? _clients;
    private string _query = "";
    private string? _error;
    private bool _open, _focusNext;
    private int _active;

    [Parameter] public string Label { get; set; } = "Client";

    [Parameter] public ClientRow? Chosen { get; set; }

    [Parameter] public EventCallback<ClientRow?> ChosenChanged { get; set; }

    /// <summary>Not offered: already owners, or chosen elsewhere on the form.</summary>
    [Parameter] public IReadOnlySet<Guid> Exclude { get; set; } = new HashSet<Guid>();

    private string Query => _query.Trim();

    private bool Excluded => _clients?.Any(c => Exclude.Contains(c.Id) && IsMatch(c)) ?? false;

    private string NoMatch => _clients is null ? "Loading…" : Excluded ? "Already an owner of this horse, or already chosen here." : $"No client matches \"{Query}\".";

    /// <summary>Clients with every word typed somewhere in their name, email or mobile; names that start with it first.</summary>
    private List<ClientRow> Matches => Query.Length == 0 || _clients is null
        ? []
        : _clients.Where(c => !Exclude.Contains(c.Id) && IsMatch(c))
            .OrderByDescending(c => c.Name.StartsWith(Query, StringComparison.OrdinalIgnoreCase)).ThenBy(c => c.Name)
            .Take(20).ToList();

    private bool IsMatch(ClientRow c) => Query.Split(' ', StringSplitOptions.RemoveEmptyEntries).All(w => Has(c.Name, w) || Has(c.Email, w) || Has(c.Mobile, w));

    private static bool Has(string? text, string word) => text?.Contains(word, StringComparison.OrdinalIgnoreCase) ?? false;

    private static string Line(ClientRow c) => $"{c.Email ?? c.Mobile ?? "No email or mobile"} · {c.Status}";

    private string OptionId(Guid id) => $"{_listId}-{id:N}";

    private async Task FocusedAsync()
    {
        _open = true;
        var result = await Api.ClientsAsync(null, null, null); // again each time: someone may just have been added in the other tab
        if (result.Succeeded) (_clients, _error) = (result.Value, null);
        else if (_clients is null) _error = result.Error;
    }

    private void Typed(ChangeEventArgs e) => (_query, _open, _active) = (e.Value?.ToString() ?? "", true, 0);

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        var matches = Matches;
        switch (e.Key)
        {
            case "ArrowDown":
                (_open, _active) = (true, matches.Count == 0 ? 0 : Math.Min(_active + 1, matches.Count - 1));
                break;
            case "ArrowUp":
                _active = Math.Max(_active - 1, 0);
                break;
            case "Enter" when _open && _active < matches.Count:
                await ChooseAsync(matches[_active]);
                break;
            case "Escape":
                _open = false;
                break;
        }
    }

    private async Task CloseSoon()
    {
        // A click on a match lands before the box loses focus (mousedown), so closing here never swallows it.
        await Task.Yield();
        _open = false;
    }

    private Task ChooseAsync(ClientRow client)
    {
        (_query, _open, _active) = ("", false, 0);
        return ChosenChanged.InvokeAsync(client);
    }

    private Task ClearAsync()
    {
        _focusNext = true;
        return ChosenChanged.InvokeAsync(null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusNext || Chosen is not null) return;
        _focusNext = false;
        await _input.FocusAsync();
    }
}
