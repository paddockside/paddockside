@*
    Write to one audience class at a time (data-model.md D12: an owner and a trainer are never on the same
    message). The audience is a single choice; the scope choices follow from it, so an owner message can never
    be scoped to the trainer and a note can never be sent. Step tag and channel override are optional.
    Laid out as the mockup's compose bar: who it goes to and how on one line, then the message and the send
    button. Staff only.
*@
<form class="grid gap-3" @onsubmit="Submit" @onsubmit:preventDefault aria-label="Write to this event">
    <div class="flex flex-wrap items-center gap-2">
        <span class="font-strong" id="@_id-to">Send to</span>
        <div class="flex flex-wrap gap-2" role="radiogroup" aria-labelledby="@_id-to">
            @foreach (var (audience, label) in AudienceOptions)
            {
                var selected = _audience == audience;
                <label class="@Chip(selected)">
                    <input type="radio" name="@_id-audience" class="sr-only" checked="@selected" @onchange="() => SetAudience(audience)" />
                    @label
                </label>
            }
        </div>

        @if (ScopeChoices.Count > 1)
        {
            <label class="sr-only" for="@_id-scope">Who can see it</label>
            <select id="@_id-scope" class="@ChipSelect" @bind="_scope">
                @foreach (var scope in ScopeChoices)
                {
                    <option value="@scope">@Marks.Label(scope)</option>
                }
            </select>
        }

        <label class="sr-only" for="@_id-step">Step</label>
        <select id="@_id-step" class="@ChipSelect" @bind="_step" @bind:after="StepChanged">
            <option value="">No step</option>
            @foreach (var step in Steps)
            {
                <option value="@step">Step: @step</option>
            }
        </select>

        @if (_audience != Audience.InternalNote)
        {
            <label class="sr-only" for="@_id-channel">Send by</label>
            <select id="@_id-channel" class="@ChipSelect" @bind="_channel">
                <option value="@Channel.Preferred">Each person's preference</option>
                <option value="@Channel.Email">Email</option>
                <option value="@Channel.Sms">Text message</option>
                <option value="@Channel.PortalOnly">Portal only, no notification</option>
            </select>
        }

        @if (_audience == Audience.Owners)
        {
            <button type="button" class="@Chip(_asking)" aria-pressed="@(_asking ? "true" : "false")" @onclick="() => _asking = !_asking">Ask a question</button>
        }

        <span class="field-hint xl:ml-auto">@Summary</span>
    </div>

    @if (_scope == Scope.NamedParties)
    {
        <fieldset class="grid gap-2">
            <legend class="field-label mb-2">Which owners</legend>
            <div class="flex flex-wrap gap-2">
                @foreach (var person in NamedPartyChoices)
                {
                    var chosen = _named.Contains(person.Id);
                    <label class="@Chip(chosen)">
                        <input type="checkbox" class="size-[18px] accent-action-primary-bg" checked="@chosen" @onchange="() => Toggle(person.Id)" />
                        @person.Name
                    </label>
                }
            </div>
        </fieldset>
    }

    @if (_asking && _audience == Audience.Owners)
    {
        <fieldset class="grid gap-3 rounded-control border border-border-subtle p-4">
            <legend class="field-label px-1">Ask a question: owners answer with buttons, and you see a tally</legend>
            <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Kind of answer">
                @foreach (var (kind, label) in PromptKinds)
                {
                    var selected = _promptKind == kind;
                    <label class="@Chip(selected)">
                        <input type="radio" name="@_id-kind" class="sr-only" checked="@selected" @onchange="() => _promptKind = kind" />
                        @label
                    </label>
                }
            </div>
            <div class="field">
                <label class="field-label" for="@_id-question">Question</label>
                <input id="@_id-question" class="input" @bind="_question" placeholder="How many owners tickets would you like?" />
            </div>
            @if (_promptKind == "Count")
            {
                <div class="field max-w-[16rem]">
                    <label class="field-label" for="@_id-max">Most anyone can ask for</label>
                    <input id="@_id-max" class="input" type="number" min="1" max="20" @bind="_max" />
                </div>
            }
            else if (_promptKind == "Choice")
            {
                <div class="field">
                    <label class="field-label" for="@_id-options">Choices, one per line</label>
                    <textarea id="@_id-options" class="input min-h-[6rem] py-3" @bind="_options" placeholder="10%&#10;5%&#10;Tell me more"></textarea>
                </div>
            }
        </fieldset>
    }

    @if (_files.Count > 0)
    {
        <ul class="flex flex-wrap gap-2" aria-label="Photos, video and voice notes to add">
            @foreach (var file in _files)
            {
                <li class="inline-flex min-h-[36px] items-center gap-2 rounded-pill border border-border-strong bg-surface-sunken pl-3 pr-1 text-small">
                    @file.Name <span class="text-text-muted">@Size(file.Size)</span>
                    <button type="button" class="grid size-[28px] place-items-center rounded-pill hover:bg-surface-raised" aria-label="Remove @file.Name" @onclick="() => _files.Remove(file)">✕</button>
                </li>
            }
        </ul>
    }

    <div class="flex flex-wrap items-end gap-3">
        <label class="sr-only" for="@_id-body">@(_files.Count > 0 ? "Caption" : _audience == Audience.InternalNote ? "Note" : "Message")</label>
        <textarea id="@_id-body" class="input min-h-[64px] min-w-0 flex-1 basis-[16rem] rounded-card py-3" rows="2" @bind="_body" @bind:event="oninput"
                  placeholder="@Placeholder" aria-describedby="@(_error is null ? null : $"{_id}-error")"></textarea>
        @if (_audience != Audience.Trainer)
        {
            @* The mockup's image button: photos, video or a voice note, with the message as the caption. *@
            <InputFile id="@($"{_id}-files")" class="sr-only" multiple accept="image/*,video/*,audio/*,.heic,.m4a,.mov" OnChange="FilesChosen" />
            <label for="@_id-files" class="btn-secondary cursor-pointer px-4" title="Add photos, video or a voice note">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15l-5-5L5 21"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle></svg>
                <span class="sr-only sm:not-sr-only">Photos or video</span>
            </label>
        }
        <button type="submit" class="btn-primary" disabled="@Busy">@SendLabel</button>
    </div>

    @if (_error is not null)
    {
        <p id="@_id-error" class="alert-danger" role="alert">@_error</p>
    }
</form>

@code {
    private readonly string _id = $"compose-{Guid.NewGuid():N}";
    private readonly HashSet<string> _named = [];
    private readonly List<IBrowserFile> _files = [];
    private Audience _audience = Audience.Owners;
    private Scope _scope = Scope.Owners;
    private Channel _channel = Channel.Preferred;
    private string _step = "";
    private string _body = "";
    private string? _error;
    private bool _asking;
    private string _promptKind = "Count";
    private string _question = "";
    private int _max = 10;
    private string _options = "";

    private static readonly (string, string)[] PromptKinds = [("Count", "A number"), ("YesNo", "Yes or no"), ("Choice", "A choice")];

    private static readonly (Audience, string)[] AudienceOptions =
    [
        (Audience.Owners, "Owners"),
        (Audience.Trainer, "Trainer"),
        (Audience.InternalNote, "Staff note"),
    ];

    /// <summary>The event's expected steps, for the step tag.</summary>
    [Parameter] public IReadOnlyList<string> Steps { get; set; } = [];

    /// <summary>The current owners, for a named-parties message.</summary>
    [Parameter] public IReadOnlyList<PartyOption> NamedPartyChoices { get; set; } = [];

    /// <summary>Questions the event's steps suggest, by step label (the tickets step asks "How many?").</summary>
    [Parameter] public IReadOnlyDictionary<string, Services.PromptRequest> StepPrompts { get; set; } = new Dictionary<string, Services.PromptRequest>();

    /// <summary>The horse's name, for the message box's prompt ("Write an update to the owners of …").</summary>
    [Parameter] public string? HorseName { get; set; }

    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback<ComposeDraft> OnSend { get; set; }

    /// <summary>The mockup's chips: a pill, green when chosen.</summary>
    private static string Chip(bool selected) =>
        "inline-flex min-h-[36px] cursor-pointer items-center gap-2 rounded-pill border px-3 text-small font-medium " +
        (selected ? "border-action-primary-bg bg-scope-owners-bg text-scope-owners-fg" : "border-border-strong bg-surface-raised hover:bg-surface-sunken");

    private const string ChipSelect = "min-h-[36px] w-auto max-w-full cursor-pointer rounded-pill border border-border-strong bg-surface-raised px-3 text-small font-medium";

    private string Placeholder => (_audience, HorseName) switch
    {
        _ when _files.Count > 0 => "Add a caption (optional)…",
        (Audience.InternalNote, _) => "Write a note for the team…",
        (Audience.Trainer, { } horse) => $"Write to {horse}'s trainer…",
        (Audience.Owners, { } horse) when _asking => "Add a message with the question (optional)…",
        (Audience.Owners, { } horse) => $"Write an update to the owners of {horse}…",
        _ => "Write a message…",
    };

    private IReadOnlyList<Scope> ScopeChoices => _audience switch
    {
        Audience.Owners => [Scope.Owners, Scope.OwnersAtTheTime, Scope.NamedParties],
        Audience.Trainer => [Scope.Trainer],
        _ => [Scope.Internal],
    };

    private string SendLabel => _audience switch
    {
        Audience.InternalNote when _files.Count > 0 => "Add for staff",
        Audience.Owners => "Send to owners",
        Audience.Trainer => "Send to trainer",
        _ => "Add note",
    };

    private string Summary => _audience switch
    {
        Audience.InternalNote => "Staff only. Nobody outside the team is told.",
        Audience.Trainer => "Owners never see what you send to the trainer.",
        _ when _scope == Scope.NamedParties => $"{_named.Count} {(_named.Count == 1 ? "owner" : "owners")} chosen. Trainers never see it.",
        _ => "Trainers never see what you send to owners.",
    };

    private void SetAudience(Audience audience)
    {
        _audience = audience;
        _scope = ScopeChoices[0];
        _error = null;
    }

    /// <summary>A step that suggests a question fills it in, unless one is already being written.</summary>
    private void StepChanged()
    {
        if (_audience != Audience.Owners || !StepPrompts.TryGetValue(_step, out var suggested) || (_asking && _question.Length > 0)) return;
        (_asking, _promptKind, _question, _max, _options) = (true, suggested.Kind, suggested.Question, suggested.Max ?? 10, string.Join('\n', suggested.Options ?? []));
    }

    private Services.PromptRequest? Prompt => !_asking || _audience != Audience.Owners ? null
        : new(_promptKind, _question.Trim(), _promptKind == "Choice" ? _options.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList() : null,
            _promptKind == "Count" ? _max : null);

    /// <summary>The most one upload takes (MediaAsset.MaxFiles on the server).</summary>
    private const int MaxFiles = 10;

    private void FilesChosen(InputFileChangeEventArgs e)
    {
        _error = null;
        foreach (var file in e.GetMultipleFiles(MaxFiles))
        {
            if (file.Size > MaxFileBytes) { _error = $"{file.Name} is too big: the most is {MaxFileBytes / 1024 / 1024} MB."; continue; }
            if (_files.Count < MaxFiles && !_files.Any(f => f.Name == file.Name && f.Size == file.Size)) _files.Add(file);
        }
    }

    /// <summary>The largest single file (MediaAsset.MaxBytes on the server).</summary>
    public const long MaxFileBytes = 250L * 1024 * 1024;

    private static string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024:0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    private void Toggle(string id)
    {
        if (!_named.Remove(id)) _named.Add(id);
    }

    private async Task Submit()
    {
        _error = _files.Count > 0 && _audience == Audience.Trainer ? "Photos and video go to the owners or the team, not the trainer."
            : _files.Count > 0 && Prompt is not null ? "Send the question on its own, then the photos."
            : _files.Count > 0 && _audience == Audience.Owners && _scope != Scope.Owners ? "Photos and video go to all the current owners. Choose \"Owners\", or keep them for staff."
            : _files.Count > 0 ? null
            : string.IsNullOrWhiteSpace(_body) && Prompt is null ? "Write something first, or ask a question."
            : _scope == Scope.NamedParties && _named.Count == 0 ? "Choose at least one owner."
            : Prompt is { } p && p.Question.Length == 0 ? "Write the question, or switch off \"Ask a question\"."
            : Prompt is { Kind: "Choice" } c && c.Options!.Count < 2 ? "Give at least two choices, one per line."
            : null;
        if (_error is not null) return;

        await OnSend.InvokeAsync(new ComposeDraft(_audience, _scope, _step == "" ? null : _step, _channel, _named.ToList(), _body.Trim(), Prompt, _files.ToList()));
        _files.Clear();
        _body = "";
        _named.Clear();
        (_asking, _question, _options) = (false, "", "");
    }
}
