@*
    The tally inside a message that asks a question (event-page-mockup-notes.md, spec item 1; the staff mockup's
    strip): the question and the totals on one line, then, on request, every owner it was asked of, with their answer,
    how it came (tapped in the portal, read from their reply, or set by staff) and when. Staff can set or correct
    anyone's answer, e.g. one taken over the phone. Staff only.
*@
<section class="grid gap-3 rounded-control bg-surface-default px-4 py-3" aria-label="Answers to: @Model.Question">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <p class="font-strong">Asked “@Model.Question”</p>
        <p class="text-small text-text-muted">@Model.Summary</p>
        <p class="flex flex-wrap gap-4 xl:ml-auto">
            @if (TicketsHref is not null)
            {
                <a href="@TicketsHref" class="font-strong underline underline-offset-4">Allocate tickets</a>
            }
            <button type="button" class="font-strong underline underline-offset-4" aria-expanded="@_open" aria-controls="@_id" @onclick="() => _open = !_open">
                @(_open ? "Hide answers" : "Answers by owner")
            </button>
        </p>
    </div>

    @if (Model.Counts.Count > 0)
    {
        <ul class="flex flex-wrap gap-2" aria-label="Totals">
            @foreach (var c in Model.Counts)
            {
                <li class="badge bg-action-secondary-bg text-text-primary">@c.Answer: @c.Count</li>
            }
        </ul>
    }

    @if (_open)
    {
    <table id="@_id" class="w-full border-collapse text-left">
        <caption class="sr-only">Each owner's answer</caption>
        <thead class="hidden sm:table-header-group">
            <tr class="border-b border-border-subtle text-small text-text-muted">
                <th scope="col" class="py-2 pr-4 font-medium">Owner</th>
                <th scope="col" class="py-2 pr-4 font-medium">Answer</th>
                <th scope="col" class="py-2 font-medium">Set it for them</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var owner in Model.Owners)
            {
                var id = $"answer-{ItemId:N}-{owner.PartyId:N}";
                <tr class="grid gap-1 border-b border-border-subtle py-2 last:border-b-0 sm:table-row">
                    <th scope="row" class="font-strong sm:py-2 sm:pr-4">@owner.Name</th>
                    <td class="sm:py-2 sm:pr-4">
                        @if (owner.Answer is null)
                        {
                            <span class="text-text-muted">Not answered yet</span>
                        }
                        else
                        {
                            <span class="font-strong">@owner.Answer</span>
                            <span class="text-small text-text-muted"> · @owner.How, @owner.At</span>
                        }
                    </td>
                    <td class="sm:py-2">
                        <label for="@id" class="sr-only">Answer for @owner.Name</label>
                        <select id="@id" class="input max-w-[12rem]" disabled="@Busy"
                                value="@(owner.Answer ?? "")" @onchange="e => OnSet.InvokeAsync((owner.PartyId, e.Value?.ToString() ?? string.Empty))">
                            <option value="" disabled>Choose…</option>
                            @foreach (var answer in Model.Answers)
                            {
                                <option value="@answer">@answer</option>
                            }
                        </select>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }
</section>

@code {
    private readonly string _id = $"answers-{Guid.NewGuid():N}";
    private bool _open;

    /// <summary>The tickets question links to the allocation screen.</summary>
    [Parameter] public string? TicketsHref { get; set; }

    [Parameter, EditorRequired] public Services.PromptView Model { get; set; } = null!;

    [Parameter, EditorRequired] public Guid ItemId { get; set; }

    [Parameter] public bool Busy { get; set; }

    /// <summary>Staff chose an answer for an owner: (party, answer).</summary>
    [Parameter] public EventCallback<(Guid PartyId, string Value)> OnSet { get; set; }
}
